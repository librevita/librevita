{
  "compilerOptions": {
    "strict": true,
    "target": "ES2017",
    "lib": ["ES2017", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["internal/ui/ts/**/*.ts"],
  "exclude": ["internal/ui/build.ts", "internal/ui/ts/ui_test.ts", "internal/ui/ts/**/*.test.ts"]
}
