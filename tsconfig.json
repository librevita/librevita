{
  "compilerOptions": {
    "strict": true,
    "target": "ES2017",
    "lib": ["ES2017", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "jsx": "react",
    "jsxFactory": "h"
  },
  "include": [
    "internal/ui/**/*.ts",
    "internal/ui/**/*.tsx",
    "postcss.config.ts",
    "tailwind.config.ts"
  ]
}
