# ---> Go
# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/tool-specific configuration
opencode.json

# LibreVita: local binaries and data
bin/
data/
*.db
*.db-shm
*.db-wal
*.log
*.log.*

# Pinned Go tools (task tools)
.tools/

# Task internal cache (sources/generates checksums)
.task/

# npm dependencies
node_modules/

# Generated frontend assets (build-time, see Taskfile frontend)
internal/ui/static/css/*.css
internal/ui/static/js/*.js
internal/ui/static/fonts/*.woff
internal/ui/static/fonts/*.woff2
internal/ui/assets.go

# Generated templ views
**/*_templ.go

# Generated Ent ORM code (source of truth: internal/database/schema/)
ent/
.entc/
**/.entc/

# Generated mocks
tests/mocks

# Generated ident UUID codecs (source of truth: pkg/ident/types.go)
pkg/ident/codec_gen.go