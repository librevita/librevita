{
  "tasks": {
    "check": "deno check internal/ui/src/ tailwind.config.ts",
    "css": "deno run -A npm:tailwindcss@3.4.17 -i internal/ui/input.css -o /out/app.css --minify -c tailwind.config.ts",
    "bundle": "deno run -A internal/ui/build.ts",
    "build": "deno task check && deno task css && deno task bundle",
    "typecheck": "deno check internal/ui/src/ tailwind.config.ts"
  },
  "imports": {
    "esbuild": "npm:esbuild@0.28.1",
    "tailwindcss": "npm:tailwindcss@3.4.17",
    "htmx": "npm:htmx.org@1.9.12",
    "alpine": "npm:@alpinejs/csp@3.15.12"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["ES2017", "DOM", "DOM.Iterable"]
  },
  "lock": true
}
