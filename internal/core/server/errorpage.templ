package server

import (
	"librevita.org/internal/ui"
)

// ErrorPage is the browser-facing error screen: plain navigations (a
// submitted form, an address-bar URL) must not dump the bare RFC 7807
// JSON in the user's face, so they receive a readable page instead —
// the problem+json envelope stays reserved for API clients. The app
// stylesheet is linked (inline style attributes would be blocked by
// the strict CSP) and the theme bootstrap ships inlined under its
// CSP content hash, so the page follows the system scheme like every
// other anonymous page.
templ ErrorPage(status int, title string, detail string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8">
			<meta name="viewport" content="width=device-width, initial-scale=1">
			<title>{ title } - LibreVita</title>
			@templ.Raw(`<script>` + ui.ThemeScript + `</script>`)
			<link rel="stylesheet" href={ ui.AppCSS } integrity={ ui.AppCSSIntegrity }>
		</head>
		<body class="flex min-h-full items-center justify-center bg-gray-50 p-4 dark:bg-gray-900">
			<div class="w-full max-w-md rounded-lg border border-gray-200 bg-white p-6 text-center shadow-sm dark:border-gray-700 dark:bg-gray-800">
				<h1 class="text-2xl font-semibold text-gray-900 dark:text-white"><span class="text-indigo-600">{ status }</span> { title }</h1>
				if detail != "" && detail != title {
					<p class="mt-2 text-sm text-gray-500 dark:text-gray-400">{ detail }</p>
				}
				<a href="/" class="mt-6 inline-block rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700">Back to LibreVita</a>
			</div>
		</body>
	</html>
}