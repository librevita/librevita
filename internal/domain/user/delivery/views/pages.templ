package views

import (
	"librevita.org/internal/core/auth"
	"librevita.org/internal/ui/components"
	"librevita.org/internal/ui/layouts"
)

// UserRow is a user listed on the dashboard.
type UserRow struct {
	Name  string
	Email string
	Role  string
	Joined string
}

// PolicyRow is a policy listed in the dashboard tabs.
type PolicyRow struct {
	Name       string
	Expression string
}

// ActivityRow is an audit event rendered on the dashboard timeline.
type ActivityRow struct {
	When     string
	Action   string
	Resource string
	Actor    string
	Result   string
	Detail   string
}

// ClinicInfo is the clinic profile shown on the dashboard.
type ClinicInfo struct {
	Name     string
	Timezone string
	City     string
	State    string
	TaxID    string
	Phone    string
	Email    string
}

// DashboardStats are the counters and lists shown on the home page.
type DashboardStats struct {
	Patients int64
	Staff    int64
	Users    int64
	Policies int64
	LatestUsers    []UserRow
	LatestPolicies []PolicyRow
	Activity       []ActivityRow
	Clinic         ClinicInfo
}

templ Home(token string, p *auth.Principal, stats DashboardStats) {
	@layouts.App("Dashboard", token, p, "dashboard") {
		<div class="mx-auto max-w-7xl">
			<div class="grid gap-4 xl:grid-cols-2 2xl:grid-cols-3">
				<div class="2xl:col-span-2">
					@components.Card() {
						@components.CardHeader("Recent activity") { }
					if len(stats.Activity) == 0 {
						<p class="text-sm text-gray-500 dark:text-gray-400">No activity recorded yet.</p>
					} else {
						<ol class="relative border-l border-gray-200">
							for _, ev := range stats.Activity {
								<li class="mb-6 ml-4">
									<span class={ "absolute w-3 h-3 rounded-full mt-1.5 -left-1.5 border border-white " + dotColor(ev.Result) }></span>
									<div class="flex items-baseline justify-between gap-4">
										<h4 class="text-sm font-semibold text-gray-900 dark:text-white">{ ev.Action }</h4>
										<time class="shrink-0 text-xs text-gray-400 dark:text-gray-400">{ ev.When }</time>
									</div>
									<p class="text-sm text-gray-500 dark:text-gray-400">{ ev.Resource }</p>
									if ev.Actor != "" {
										<p class="mt-0.5 text-xs text-gray-400 dark:text-gray-400">{ ev.Actor }</p>
									}
									if ev.Detail != "" {
										<p class="mt-1 truncate text-xs text-red-600 dark:text-red-400">{ ev.Detail }</p>
									}
								</li>
							}
						</ol>
					}
					}
				</div>
				<section>
					@components.Card() {
						<header class="mb-4">
							<h3 class="text-lg font-semibold text-gray-900 dark:text-white">Statistics</h3>
						</header>
					<div x-data="tabs">
						<ul class="hidden divide-x divide-gray-200 rounded-lg text-center text-sm font-medium text-gray-500 dark:divide-gray-700 dark:text-gray-400 sm:flex" role="tablist">
							<li class="w-full" role="presentation">
								<button type="button" @click="set('users')" :class="tabClass('users', 'bg-gray-50 text-gray-900 dark:bg-gray-700 dark:text-white')" class="inline-block w-full rounded-tl-lg p-3 hover:bg-gray-100 dark:hover:bg-gray-700" role="tab">Latest users</button>
							</li>
							<li class="w-full" role="presentation">
								<button type="button" @click="set('policies')" :class="tabClass('policies', 'bg-gray-50 text-gray-900 dark:bg-gray-700 dark:text-white')" class="inline-block w-full rounded-tr-lg p-3 hover:bg-gray-100 dark:hover:bg-gray-700" role="tab">Access policies</button>
							</li>
						</ul>
						<div class="border-t border-gray-200 dark:border-gray-700">
							<div x-show="active === 'users'" class="pt-2">
								<ul class="divide-y divide-gray-200 dark:divide-gray-700" role="list">
									for _, u := range stats.LatestUsers {
										<li class="py-3">
											<div class="flex items-center space-x-4">
												@components.Avatar(components.Initials(u.Name), "h-8 w-8 bg-indigo-100 text-indigo-700 dark:bg-indigo-900 dark:text-indigo-300")
												<div class="min-w-0 flex-1">
													<p class="truncate font-medium text-gray-900 dark:text-white">{ u.Name }</p>
													<p class="truncate text-sm text-gray-500 dark:text-gray-400">{ u.Email }</p>
												</div>
												@components.Badge(u.Role)
											</div>
										</li>
									}
								</ul>
							</div>
							<div x-show="active === 'policies'" class="pt-2">
								<ul class="divide-y divide-gray-200 dark:divide-gray-700" role="list">
									for _, pl := range stats.LatestPolicies {
										<li class="py-3">
											<p class="font-medium text-gray-900 dark:text-white">{ pl.Name }</p>
											<p class="mt-0.5 truncate font-mono text-xs text-gray-500 dark:text-gray-400">{ pl.Expression }</p>
										</li>
									}
								</ul>
							</div>
						</div>
					</div>
					}
				</section>
			</div>
			<div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 2xl:grid-cols-4">
				@components.StatCard("Patients", stats.Patients)
				@components.StatCard("Staff", stats.Staff)
				@components.StatCard("Total users", stats.Users)
				@components.StatCard("Access policies", stats.Policies)
			</div>
			<div class="my-4 grid grid-cols-1 xl:grid-cols-2 xl:gap-4">
				<div class="mb-4 xl:mb-0">
					@components.Card() {
						@components.CardHeader("Registered users") { }
					<div class="flex flex-col">
						<div class="overflow-x-auto rounded-lg">
							<div class="inline-block min-w-full align-middle">
								<div class="overflow-hidden shadow sm:rounded-lg">
									<table class="min-w-full divide-y divide-gray-200 text-sm">
										@components.Thead() {
											<tr>
												@components.Th("Name", "p-4")
												@components.Th("Email", "p-4")
												@components.Th("Role", "p-4")
												@components.Th("Joined", "p-4")
											</tr>
										}
										<tbody class="bg-white dark:bg-gray-800">
											for _, u := range stats.LatestUsers {
												<tr>
													<td class="whitespace-nowrap p-4 font-normal text-gray-900 dark:text-white">{ u.Name }</td>
													<td class="whitespace-nowrap p-4 font-normal text-gray-500 dark:text-gray-400">{ u.Email }</td>
													<td class="whitespace-nowrap p-4">@components.Badge(u.Role)</td>
													<td class="whitespace-nowrap p-4 font-normal text-gray-500 dark:text-gray-400">{ u.Joined }</td>
												</tr>
											}
										</tbody>
									</table>
								</div>
							</div>
						</div>
					</div>
					}
				</div>
				<section>
					@components.Card() {
						@components.CardHeader("Clinic profile") { }
					<dl class="space-y-3 text-sm">
						<div class="flex items-center justify-between gap-4">
							<dt class="text-gray-500 dark:text-gray-400">Name</dt>
							<dd class="font-medium text-gray-900 dark:text-white">{ stats.Clinic.Name }</dd>
						</div>
						<div class="flex items-center justify-between gap-4">
							<dt class="text-gray-500 dark:text-gray-400">Timezone</dt>
							<dd class="font-medium text-gray-900 dark:text-white">{ stats.Clinic.Timezone }</dd>
						</div>
						if stats.Clinic.City != "" {
							<div class="flex items-center justify-between gap-4">
								<dt class="text-gray-500 dark:text-gray-400">City</dt>
								<dd class="font-medium text-gray-900 dark:text-white">{ stats.Clinic.City }, { stats.Clinic.State }</dd>
							</div>
						}
						if stats.Clinic.TaxID != "" {
							<div class="flex items-center justify-between gap-4">
								<dt class="text-gray-500 dark:text-gray-400">Tax ID</dt>
								<dd class="font-medium text-gray-900 dark:text-white">{ stats.Clinic.TaxID }</dd>
							</div>
						}
						if stats.Clinic.Phone != "" {
							<div class="flex items-center justify-between gap-4">
								<dt class="text-gray-500 dark:text-gray-400">Phone</dt>
								<dd class="font-medium text-gray-900 dark:text-white">{ stats.Clinic.Phone }</dd>
							</div>
						}
						if stats.Clinic.Email != "" {
							<div class="flex items-center justify-between gap-4">
								<dt class="text-gray-500 dark:text-gray-400">Email</dt>
								<dd class="font-medium text-gray-900 dark:text-white">{ stats.Clinic.Email }</dd>
							</div>
						}
					</dl>
					if p != nil && p.Role == auth.RoleAdmin {
						<a class="mt-4 inline-flex items-center rounded-lg p-2 text-sm font-medium text-indigo-700 hover:bg-gray-100 dark:text-indigo-400 dark:hover:bg-gray-700" href="/admin/policies">Access policies</a>
					}
					}
				</section>
			</div>
		</div>
	}
}

templ Admin(token string, p *auth.Principal) {
	@layouts.App("Admin area", token, p, "admin") {
		<div class="mx-auto max-w-4xl">
			<p class="text-sm text-gray-600">
				Only users with the <strong class="text-gray-900">admin</strong> role can see this page.
			</p>
			<nav class="mt-6 flex flex-wrap gap-3">
				<a class="btn" href="/admin/policies">Access policies</a>
				<a class="btn-secondary" href="/">Back to dashboard</a>
			</nav>
		</div>
	}
}

func dotColor(result string) string {
	switch result {
	case "success":
		return "bg-green-400"
	case "failure":
		return "bg-red-400"
	default:
		return "bg-gray-200"
	}
}

