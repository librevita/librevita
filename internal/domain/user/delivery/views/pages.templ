package views

import (
	"librevita.org/internal/core/auth"
	"librevita.org/internal/ui/layouts"
)

// DashboardStats are the counters shown on the home page.
type DashboardStats struct {
	Patients int64
	Staff    int64
	Users    int64
	Policies int64
}

templ Home(token string, p *auth.Principal, stats DashboardStats) {
	@layouts.App("Dashboard", token, p, "dashboard") {
		<div class="mx-auto max-w-6xl">
			<h2 class="text-lg font-semibold text-gray-900">Welcome, { p.Name }</h2>
			<p class="mt-1 text-sm text-gray-600">
				Signed in as <strong class="text-gray-900">{ p.Role.String() }</strong> ({ p.Email })
			</p>
			<div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
				@statCard("Patients", stats.Patients, "users", "bg-indigo-100 text-indigo-600")
				@statCard("Staff", stats.Staff, "users", "bg-green-100 text-green-600")
				@statCard("Total users", stats.Users, "users", "bg-blue-100 text-blue-600")
				@statCard("Access policies", stats.Policies, "policies", "bg-amber-100 text-amber-600")
			</div>
		</div>
	}
}

templ Admin(token string, p *auth.Principal) {
	@layouts.App("Admin area", token, p, "admin") {
		<div class="mx-auto max-w-4xl">
			<p class="text-sm text-gray-600">
				Only users with the <strong class="text-gray-900">admin</strong> role can see this page.
			</p>
			<nav class="mt-6 flex flex-wrap gap-3">
				<a class="btn" href="/admin/policies">Access policies</a>
				<a class="btn-secondary" href="/">Back to dashboard</a>
			</nav>
		</div>
	}
}

templ statCard(label string, value int64, icon string, accent string) {
	<div class="rounded-lg border border-gray-200 bg-white p-5">
		<div class="flex items-start justify-between">
			<div>
				<p class="text-sm text-gray-500">{ label }</p>
				<p class="mt-1 text-2xl font-bold text-gray-900">{ value }</p>
			</div>
			<div class={ "flex h-12 w-12 shrink-0 items-center justify-center rounded-lg " + accent }>
				@statIcon(icon)
			</div>
		</div>
	</div>
}

templ statIcon(name string) {
	switch name {
	case "users":
		<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
			<path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
		</svg>
	case "policies":
		<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
			<path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
		</svg>
	}
}
