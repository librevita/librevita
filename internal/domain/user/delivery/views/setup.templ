package views

import (
	"librevita.org/internal/core/auth"
	clinicmodel "librevita.org/internal/domain/clinic/model"
	identifiermodel "librevita.org/internal/domain/identifier/model"
	"librevita.org/internal/ui/layouts"
)

templ PlatformBootstrap(token string, errMsg string) {
	@layouts.Base("Platform setup", auth.UIThemeSystem, token) {
		<main class="flex min-h-full items-center justify-center px-4 py-8">
			<div class="card w-full max-w-lg">
				<h1 class="text-2xl font-semibold text-gray-900 dark:text-white">LibreVita</h1>
				<h2 class="mt-1 text-sm text-gray-500 dark:text-gray-400">Platform operator</h2>
				<p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Create the first installation operator. Clinics are provisioned after you sign in.</p>
				if errMsg != "" {
					<div class="alert mt-4" role="alert">{ errMsg }</div>
				}
				<form method="post" hx-boost="false" action="/setup" class="mt-6 space-y-4">
					<input type="hidden" name="_csrf" value={ token }>
					<div>
						<label class="label" for="admin_name">Name</label>
						<input class="input" id="admin_name" type="text" name="admin_name" required autofocus>
					</div>
					<div>
						<label class="label" for="admin_email">Email</label>
						<input class="input" id="admin_email" type="email" name="admin_email" required>
					</div>
					<div>
						<label class="label" for="admin_password">Password</label>
						<input class="input" id="admin_password" type="password" name="admin_password" minlength="8" required>
					</div>
					<button class="btn w-full" type="submit">Create operator</button>
				</form>
			</div>
		</main>
	}
}

templ ClinicSetup(token string, clinicName string, systems []*identifiermodel.IdentifierSystem, errMsg string) {
	@layouts.Base("Clinic setup", auth.UIThemeSystem, token) {
		<main class="flex min-h-full items-center justify-center px-4 py-8">
			<div class="card w-full max-w-lg">
				<h1 class="text-2xl font-semibold text-gray-900 dark:text-white">LibreVita</h1>
				<h2 class="mt-1 text-sm text-gray-500 dark:text-gray-400">
					if clinicName != "" {
						{ clinicName }
					} else {
						Clinic setup
					}
				</h2>
				<p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Create the clinic administrator and choose which identifier systems this clinic uses.</p>
				if errMsg != "" {
					<div class="alert mt-4" role="alert">{ errMsg }</div>
				}
				<form method="post" hx-boost="false" action="/setup" class="mt-6 space-y-6">
					<input type="hidden" name="_csrf" value={ token }>
					<fieldset class="space-y-4">
						<legend class="text-sm font-semibold text-gray-900 dark:text-white">Administrator</legend>
						<div>
							<label class="label" for="admin_name">Name</label>
							<input class="input" id="admin_name" type="text" name="admin_name" required autofocus>
						</div>
						<div>
							<label class="label" for="admin_email">Email</label>
							<input class="input" id="admin_email" type="email" name="admin_email" required>
						</div>
						<div>
							<label class="label" for="admin_password">Password</label>
							<input class="input" id="admin_password" type="password" name="admin_password" minlength="8" required>
						</div>
					</fieldset>
					if len(systems) > 0 {
						<fieldset class="space-y-3">
							<legend class="text-sm font-semibold text-gray-900 dark:text-white">Identifier systems</legend>
							<p class="text-xs text-gray-500 dark:text-gray-400">Leave all checked to enable the full catalog. Uncheck systems this clinic will not use.</p>
							for _, sys := range systems {
								if sys != nil && sys.Active {
									<label class="flex items-center space-x-2 text-sm text-gray-700 dark:text-gray-200">
										<input class="rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" type="checkbox" name="identifier_system_id" value={ sys.ID.String() } checked>
										<span>{ sys.DisplayName }</span>
									</label>
								}
							}
						</fieldset>
					}
					<button class="btn w-full" type="submit">Finish clinic setup</button>
				</form>
			</div>
		</main>
	}
}

templ Provision(token string, errMsg string) {
	@layouts.Base("Provision clinic", auth.UIThemeSystem, token) {
		<main class="flex min-h-full items-center justify-center px-4 py-8">
			<div class="card w-full max-w-lg">
				<h1 class="text-2xl font-semibold text-gray-900 dark:text-white">New clinic</h1>
				<p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Creates the clinic shell and encryption keys. The clinic administrator finishes setup on the clinic subdomain.</p>
				if errMsg != "" {
					<div class="alert mt-4" role="alert">{ errMsg }</div>
				}
				<form method="post" hx-boost="false" action="/clinics" class="mt-6 space-y-4">
					<input type="hidden" name="_csrf" value={ token }>
					<div>
						<label class="label" for="clinic_name">Name</label>
						<input class="input" id="clinic_name" type="text" name="clinic_name" required autofocus>
					</div>
					<div>
						<label class="label" for="clinic_slug">Subdomain</label>
						<input class="input" id="clinic_slug" type="text" name="clinic_slug" pattern="[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?" required>
						<p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Letters, digits, and hyphens. Reserved labels such as www are not allowed.</p>
					</div>
					<div class="flex space-x-4">
						<div class="flex-1">
							<label class="label" for="clinic_tax_id">Tax ID</label>
							<input class="input" id="clinic_tax_id" type="text" name="clinic_tax_id">
						</div>
						<div class="flex-1">
							<label class="label" for="clinic_phone">Phone</label>
							<input class="input" id="clinic_phone" type="tel" name="clinic_phone">
						</div>
					</div>
					<div>
						<label class="label" for="clinic_email">Email</label>
						<input class="input" id="clinic_email" type="email" name="clinic_email">
					</div>
					<div>
						<label class="label" for="clinic_street">Street</label>
						<input class="input" id="clinic_street" type="text" name="clinic_street">
					</div>
					<div class="flex space-x-4">
						<div class="flex-1">
							<label class="label" for="clinic_city">City</label>
							<input class="input" id="clinic_city" type="text" name="clinic_city">
						</div>
						<div class="flex-1">
							<label class="label" for="clinic_state">State</label>
							<input class="input" id="clinic_state" type="text" name="clinic_state">
						</div>
						<div class="flex-1">
							<label class="label" for="clinic_postal_code">Postal code</label>
							<input class="input" id="clinic_postal_code" type="text" name="clinic_postal_code">
						</div>
					</div>
					<div>
						<label class="label" for="clinic_timezone">Timezone</label>
						<select class="input" id="clinic_timezone" name="clinic_timezone">
							for _, g := range clinicmodel.TimeZones {
								<optgroup label={ g.Label }>
									for _, zone := range g.Zones {
										if zone == clinicmodel.DefaultTimezone {
											<option value={ zone } selected>{ zone }</option>
										} else {
											<option value={ zone }>{ zone }</option>
										}
									}
								</optgroup>
							}
						</select>
					</div>
					<button class="btn w-full" type="submit">Provision clinic</button>
				</form>
			</div>
		</main>
	}
}

templ PlatformHome(token string, p *auth.Principal, clinics []*clinicmodel.Clinic, baseDomain string) {
	@layouts.App("Clinics", token, p, "dashboard") {
		<div class="mx-auto max-w-4xl p-4 lg:p-6">
			<div class="mb-6 flex items-center justify-between">
				<div>
					<h2 class="text-xl font-semibold text-gray-900 dark:text-white">Clinics</h2>
					<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Provision a shell, then finish setup on the clinic subdomain.</p>
				</div>
				<a href="/clinics/new" class="btn">New clinic</a>
			</div>
			if len(clinics) == 0 {
				<p class="text-sm text-gray-500 dark:text-gray-400">No clinics yet.</p>
			} else {
				<ul class="divide-y divide-gray-200 rounded-lg border border-gray-200 bg-white dark:divide-gray-700 dark:border-gray-700 dark:bg-gray-800">
					for _, c := range clinics {
						if c != nil {
							<li class="flex items-center justify-between px-4 py-3">
								<div>
									<p class="font-medium text-gray-900 dark:text-white">{ c.Name }</p>
									<p class="text-sm text-gray-500 dark:text-gray-400">{ c.Slug }.{ baseDomain }</p>
								</div>
								if c.Onboarded() {
									<span class="text-xs font-medium text-green-700 dark:text-green-400">Ready</span>
								} else {
									<span class="text-xs font-medium text-amber-700 dark:text-amber-400">Awaiting setup</span>
								}
							</li>
						}
					}
				</ul>
			}
		</div>
	}
}
