package views

import (
	"librevita.org/internal/core/auth"
	"librevita.org/internal/ui/components"
	"librevita.org/internal/ui/layouts"
)

// SpecialtyRow is one entry of the clinic's specialty catalog.
type SpecialtyRow struct {
	ID   string
	Name string
}

// SpecialtyView is a catalog entry joined with the user's selection.
type SpecialtyView struct {
	ID       string
	Name     string
	Selected bool
}

// SpecialtiesPage lists the clinician specialties the administrator can
// assign to accounts (psychologist, physiotherapist, ...).
templ SpecialtiesPage(token string, p *auth.Principal, rows []SpecialtyRow, errMsg string) {
	@layouts.App("Specialties", token, p, "users") {
		<div class="w-full">
			<div class="border-b border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800">
				<nav class="mb-4" aria-label="Breadcrumb">
					<ol class="inline-flex items-center space-x-1 text-sm font-medium md:space-x-2">
						<li class="inline-flex items-center">
							<a href="/" class="inline-flex items-center text-gray-700 hover:text-indigo-600 dark:text-gray-300 dark:hover:text-white">
								<svg class="mr-2.5 h-5 w-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path></svg>
								Home
							</a>
						</li>
						<li>
							<div class="flex items-center">
								<svg class="h-6 w-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
								<a href="/users" class="ml-1 text-gray-700 hover:text-indigo-600 md:ml-2 dark:text-gray-300 dark:hover:text-white">Users</a>
							</div>
						</li>
						<li>
							<div class="flex items-center">
								<svg class="h-6 w-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
								<span class="ml-1 text-gray-400 md:ml-2 dark:text-gray-500" aria-current="page">Specialties</span>
							</div>
						</li>
					</ol>
				</nav>
				<h1 class="mb-4 text-xl font-semibold text-gray-900 sm:text-2xl dark:text-white">Specialties</h1>
				<form method="post" hx-post="/specialties" hx-target="this" hx-swap="outerHTML" class="flex max-w-md items-center gap-2">
					<input type="hidden" name="_csrf" value={ token }>
					@components.Input("name", "pl-3", templ.Attributes{ "type": "text", "placeholder": "e.g. Psychologist", "required": true })
					@components.Button("primary", "Add specialty", templ.Attributes{ "type": "submit" })
				</form>
			</div>
			<div class="flex flex-col p-4">
				if errMsg != "" {
					<div class="mb-4">@components.Alert(errMsg, false)</div>
				}
				<div class="overflow-hidden shadow-sm">
					<div class="overflow-x-auto">
						<table class="min-w-full divide-y divide-gray-200 dark:divide-gray-600">
							<thead class="bg-gray-100 dark:bg-gray-700">
								<tr>
									@components.Th("Name", "p-4")
									<th scope="col" class="p-4 text-right text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Actions</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-gray-200 bg-white dark:divide-gray-700 dark:bg-gray-800">
								for _, sp := range rows {
									<tr class="hover:bg-gray-100 dark:hover:bg-gray-700">
										<td class="p-4 text-base font-medium text-gray-900 dark:text-white">{ sp.Name }</td>
										<td class="p-4 text-right">
											<form method="post" action={ "/specialties/" + sp.ID + "/delete" } class="inline">
												<input type="hidden" name="_csrf" value={ token }>
												@components.Button("danger", "Delete", templ.Attributes{ "type": "submit" })
											</form>
										</td>
									</tr>
								}
								if len(rows) == 0 {
									<tr>
										<td colspan="2" class="px-4 py-8 text-center text-sm text-gray-500 dark:text-gray-400">No specialties yet. Add the clinician specialties your clinic works with.</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
	}
}
