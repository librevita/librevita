package views

import (
	"librevita.org/internal/ui/shared"
	"librevita.org/internal/core/auth"
	"librevita.org/internal/ui/components"
	"librevita.org/internal/ui/layouts"
)

// Profile renders the signed-in user's profile: identity card and the
// preference form (color scheme and personal timezone).
templ Profile(token string, p *auth.Principal, joined string, errMsg string) {
	@layouts.App("Profile", token, p, "profile") {
		<div class="mx-auto max-w-3xl p-4 lg:p-6">
			<section class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-gray-800">
				<div class="flex items-center gap-4">
					@components.Avatar(shared.Initials(p.Name), "h-16 w-16 bg-indigo-600 text-white text-xl")
					<div class="min-w-0">
						<h2 class="truncate text-lg font-semibold text-gray-900 dark:text-white">{ p.Name }</h2>
						<p class="truncate text-sm text-gray-500 dark:text-gray-400">{ p.Email }</p>
						<p class="mt-1 text-xs text-gray-400 dark:text-gray-400">Joined { joined }</p>
					</div>
					<span class="ml-auto shrink-0">@components.Badge(p.Role.String())</span>
				</div>
			</section>
			<form method="post" action="/profile" hx-post="/profile" hx-target="body" hx-trigger="change from:input[name='ui_theme'], change from:select[name='timezone'], submit" class="mt-4 space-y-6 rounded-lg border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-gray-800">
				<input type="hidden" name="_csrf" value={ token }>
				<section>
					@components.CardHeader("Appearance")
					<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
						Choose how LibreVita looks. System follows your browser or operating system preference. Your choice is applied immediately.
					</p>
					<fieldset class="mt-4">
						<legend class="sr-only">Color scheme</legend>
						<div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
							@themeChoice("light", "Light", p.UITheme.String())
							@themeChoice("system", "System", p.UITheme.String())
							@themeChoice("dark", "Dark", p.UITheme.String())
						</div>
					</fieldset>
				</section>
				<section>
					@components.CardHeader("Timezone")
					<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
						Timestamps are shown in your timezone. Default uses the clinic timezone.
					</p>
					<div class="mt-4 max-w-md">
						<label class="label" for="timezone">Timezone</label>
						@components.TimezoneSelect(p.Timezone)
					</div>
				</section>
				if errMsg != "" {
					<div>@components.Alert(errMsg, false)</div>
				}
				<div class="flex justify-end">
					<button class="btn" type="submit">Save preferences</button>
				</div>
			</form>
		</div>
	}
}

// themeChoice is one color scheme option: a hidden radio styled by its
// peer label, so no JavaScript is needed to persist the choice. Each
// option lives in its own wrapper: the Tailwind peer selector is a
// general sibling combinator, so with all radios as siblings the
// checked state would also highlight every later label.
templ themeChoice(value string, label string, selected string) {
	<div>
		if selected == value {
			<input type="radio" name="ui_theme" id={ "theme-" + value } value={ value } class="peer sr-only" checked>
		} else {
			<input type="radio" name="ui_theme" id={ "theme-" + value } value={ value } class="peer sr-only">
		}
		<label for={ "theme-" + value } class="flex cursor-pointer items-center gap-3 rounded-lg border border-gray-200 px-4 py-3 text-sm font-medium text-gray-700 hover:bg-gray-50 focus-within:ring-2 focus-within:ring-indigo-500 peer-checked:border-indigo-500 peer-checked:bg-indigo-50 peer-checked:text-indigo-700 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700 dark:peer-checked:border-indigo-400 dark:peer-checked:bg-indigo-900/40 dark:peer-checked:text-indigo-300">
			@themeIcon(value)
			{ label }
		</label>
	</div>
}

templ themeIcon(name string) {
	switch name {
	case "light":
		<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
			<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
		</svg>
	case "system":
		<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
			<path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25" />
		</svg>
	case "dark":
		<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
			<path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
		</svg>
	}
}
