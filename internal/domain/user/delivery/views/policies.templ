package views

import (
	"librevita.org/internal/core/auth"
	"librevita.org/internal/ui/components"
	"librevita.org/internal/ui/layouts"
)

// PolicyHistoryRow is a stored policy version with its timestamp already
// rendered in the clinic's timezone.
type PolicyHistoryRow struct {
	Expression     string
	ChangedBy      *string
	ChangedByEmail *string
	Origin         string
	When           string
}

// PolicyView is a stored policy decorated with its recent change history.
type PolicyView struct {
	Name       string
	Expression string
	History    []PolicyHistoryRow
}

templ AdminPolicies(token string, p *auth.Principal, policies []PolicyView, errMsg string) {
	@layouts.App("Access policies", token, p, "policies") {
		<div class="mx-auto max-w-4xl p-4 lg:p-6">
			if errMsg != "" {
				<div class="alert mb-4" role="alert">{ errMsg }</div>
			}
			<p class="mt-4 text-sm text-gray-600">
				Policies are CEL expressions evaluated with the <code class="rounded bg-gray-100 px-1">principal</code>
				and <code class="rounded bg-gray-100 px-1">request</code> variables. They take effect immediately after saving.
			</p>
			<div class="mt-6 space-y-8">
				for _, pl := range policies {
					@PolicyCard(token, pl, "")
				}
			</div>
		</div>
	}
}

// PolicyCard is the per-policy fragment: htmx saves and resets replace it
// in place, so errors stay with their card.
templ PolicyCard(token string, pl PolicyView, errMsg string) {
	<section class="card">
		<form method="post" action="/policies" hx-post="/policies" hx-target="closest section" hx-swap="outerHTML" class="space-y-3">
			<input type="hidden" name="_csrf" value={ token }>
			<input type="hidden" name="name" value={ pl.Name }>
			<label class="label" for={ "policy-" + pl.Name }>
				<span class="font-semibold text-gray-900 dark:text-white">{ pl.Name }</span>
				<textarea class="input font-mono" id={ "policy-" + pl.Name } name="expression" rows="3" required>{ pl.Expression }</textarea>
			</label>
			if errMsg != "" {
				<p class="text-xs text-red-600 dark:text-red-400">{ errMsg }</p>
			}
			<div class="flex items-center space-x-3">
				<button class="btn" type="submit">Save</button>
				<button type="button" class="btn-secondary" hx-post="/policies/reset" hx-vals={ policyVals(pl.Name) } hx-target="closest section" hx-swap="outerHTML">Reset to default</button>
			</div>
		</form>
		if len(pl.History) > 0 {
			<div class="mt-6 overflow-x-auto">
				<table class="table-base">
					<caption class="text-left text-sm font-semibold text-gray-900 py-2 dark:text-white">Change history</caption>
					@components.Thead() {
						<tr>
							<th class="px-3 py-2 text-left font-medium text-gray-500 dark:text-gray-400">Expression</th>
							<th class="px-3 py-2 text-left font-medium text-gray-500 dark:text-gray-400">Changed by</th>
							<th class="px-3 py-2 text-left font-medium text-gray-500 dark:text-gray-400">Origin</th>
							<th class="px-3 py-2 text-left font-medium text-gray-500 dark:text-gray-400">When</th>
						</tr>
					}
					<tbody class="divide-y divide-gray-200 dark:divide-gray-700">
						for _, v := range pl.History {
							<tr>
								<td class="px-3 py-2 font-mono text-xs dark:text-gray-300">{ v.Expression }</td>
								<td class="px-3 py-2 dark:text-gray-300">{ changedBy(v.ChangedBy, v.ChangedByEmail) }</td>
								<td class="px-3 py-2 dark:text-gray-300">{ v.Origin }</td>
								<td class="px-3 py-2 text-xs text-gray-500 dark:text-gray-400">{ v.When }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
}

func policyVals(name string) string {
	return "{\"name\":\"" + name + "\"}"
}

func changedBy(id, email *string) string {
	if email != nil && *email != "" {
		return *email
	}
	if id != nil && *id != "" {
		return *id
	}
	return "system"
}
