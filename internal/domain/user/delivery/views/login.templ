package views

import (
	"librevita.org/internal/types"
	"librevita.org/internal/ui/layouts"
)

// Login renders the sign-in page. The layout follows the Flowbite admin
// dashboard sign-in card: centered logo, then a wide white card with the
// email and password fields.
templ Login(token string, next string, errMsg string) {
	@layouts.Base("Sign in", types.UIThemeSystem) {
		<main class="flex min-h-full flex-col items-center justify-center px-6 pt-8">
			<a href="/auth/login" class="mb-8 flex items-center justify-center text-2xl font-semibold text-gray-900 dark:text-white">
				<span class="mr-4">@layouts.Logo("h-11 w-11 text-indigo-600")</span>
				<span>LibreVita</span>
			</a>
			<div class="w-full max-w-xl space-y-8 rounded-lg bg-white p-6 shadow sm:p-8 dark:bg-gray-800">
				<h2 class="text-2xl font-bold text-gray-900 dark:text-white">Sign in to LibreVita</h2>
				if errMsg != "" {
					<div class="alert" role="alert">{ errMsg }</div>
				}
				<form method="post" hx-boost="false" action="/auth/login" class="space-y-6">
					<input type="hidden" name="_csrf" value={ token }>
					if next != "" {
						<input type="hidden" name="next" value={ next }>
					}
					<div>
						<label class="mb-2 block text-sm font-medium text-gray-900 dark:text-white" for="email">Your email</label>
						<input class="auth-input" id="email" type="email" name="email" placeholder="name@company.com" required autofocus>
					</div>
					<div>
						<label class="mb-2 block text-sm font-medium text-gray-900 dark:text-white" for="password">Your password</label>
						<input class="auth-input" id="password" type="password" name="password" placeholder="••••••••" required>
					</div>
					<button class="w-full rounded-lg bg-indigo-600 px-5 py-2.5 text-center text-sm font-medium text-white hover:bg-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-300" type="submit">Login to your account</button>
				</form>
			</div>
		</main>
	}
}
