package views

import (
	"net/url"
	"strconv"

	"librevita.org/internal/core/auth"
	"librevita.org/internal/ui/components"
	"librevita.org/internal/ui/layouts"
	"librevita.org/internal/ui/shared"
)

// UserListRow is one account line of the management table.
type UserListRow struct {
	ID        string
	Name      string
	Email     string
	Role      string
	Active    int64
	CreatedAt string
}

// UserFormValues carries the current form values so the form can redraw
// after a validation error.
type UserFormValues struct {
	Name     string
	Email    string
	Password string
	Role     string
	Active   bool
}

// UsersListPage renders the account management table following the
// flowbite-admin-dashboard CRUD layout: breadcrumb, toolbar with search
// and the primary action, the paged table, and the pager footer.
templ UsersListPage(token string, p *auth.Principal, q string, page int, total int64, rows []UserListRow, errMsg string) {
	@layouts.App("Users", token, p, "users") {
		<div class="w-full">
			<div class="border-b border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800">
				<nav class="mb-4" aria-label="Breadcrumb">
					<ol class="inline-flex items-center space-x-1 text-sm font-medium md:space-x-2">
						<li class="inline-flex items-center">
							<a href="/" class="inline-flex items-center text-gray-700 hover:text-indigo-600 dark:text-gray-300 dark:hover:text-white">
								<svg class="mr-2.5 h-5 w-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path></svg>
								Home
							</a>
						</li>
						<li>
							<div class="flex items-center">
								<svg class="h-6 w-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
								<a href="/admin/users" class="ml-1 text-gray-700 hover:text-indigo-600 md:ml-2 dark:text-gray-300 dark:hover:text-white">Users</a>
							</div>
						</li>
						<li>
							<div class="flex items-center">
								<svg class="h-6 w-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
								<span class="ml-1 text-gray-400 md:ml-2 dark:text-gray-500" aria-current="page">List</span>
							</div>
						</li>
					</ol>
				</nav>
				<h1 class="mb-4 text-xl font-semibold text-gray-900 sm:text-2xl dark:text-white">All users</h1>
				<div class="flex flex-wrap items-center justify-between gap-3">
					<div class="relative">
						<svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-gray-400 dark:text-gray-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"></path></svg>
						@components.Input("q", "pl-9 md:w-64 xl:w-96", templ.Attributes{ "id": "user-search", "type": "search", "value": q, "placeholder": "Search for users", "hx-get": "/admin/users", "hx-trigger": "input changed delay:300ms", "hx-target": "#user-list", "hx-swap": "innerHTML" })
					</div>
					@components.ButtonLink("primary", "/admin/users/new", "Add user", nil)
				</div>
			</div>
			<div class="flex flex-col">
				<div id="user-list">
					@UsersListTable(rows, q, page, total, errMsg)
				</div>
			</div>
		</div>
	}
}

// UsersListTable is the fragment swapped by the search input and the
// pager: the table plus the pager refresh together.
templ UsersListTable(rows []UserListRow, q string, page int, total int64, errMsg string) {
	if errMsg != "" {
		<div class="mb-4">@components.Alert(errMsg, false)</div>
	}
	if len(rows) == 0 {
		<div class="overflow-hidden rounded-lg bg-white p-6 text-center shadow-sm dark:bg-gray-800">
			<p class="text-sm text-gray-500 dark:text-gray-400">No users found</p>
		</div>
	} else {
		<div class="overflow-hidden shadow-sm">
			<div class="overflow-x-auto">
				<table class="min-w-full divide-y divide-gray-200 dark:divide-gray-600">
					<thead class="bg-gray-100 dark:bg-gray-700">
						<tr>
							@components.Th("Name", "p-4")
							@components.Th("Role", "p-4")
							@components.Th("Status", "p-4")
							@components.Th("Created", "p-4")
							<th scope="col" class="p-4 text-right text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Actions</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-gray-200 bg-white dark:divide-gray-700 dark:bg-gray-800">
						for _, u := range rows {
							<tr class="hover:bg-gray-100 dark:hover:bg-gray-700">@UserRowCells(u)</tr>
						}
					</tbody>
				</table>
			</div>
			@userPager(q, page, total, int64(len(rows)))
		</div>
	}
}

// UserRowOnly is the status toggle response: a bare row, swapped in
// place. No sibling elements may follow, or the htmx fragment parser
// wraps the row into a table and mis-parses them.
templ UserRowOnly(rows []UserListRow) {
	for _, u := range rows {
		<tr class="hover:bg-gray-100 dark:hover:bg-gray-700">@UserRowCells(u)</tr>
	}
}

// UserRowCells is the row fragment swapped by the status toggle, so the
// change re-renders only the affected row.
templ UserRowCells(u UserListRow) {
	<td class="p-4">
		<div class="flex items-center gap-3">
			@components.Avatar(shared.Initials(u.Name), "h-10 w-10 text-sm bg-indigo-100 text-indigo-700 dark:bg-indigo-900 dark:text-indigo-300")
			<div>
				<p class="text-base font-semibold text-gray-900 dark:text-white">{ u.Name }</p>
				<p class="text-sm text-gray-500 dark:text-gray-400">{ u.Email }</p>
			</div>
		</div>
	</td>
	<td class="p-4 whitespace-nowrap text-base font-medium text-gray-900 dark:text-white">@components.Badge(u.Role)</td>
	<td class="p-4 whitespace-nowrap">@userStatusCell(u)</td>
	<td class="p-4 whitespace-nowrap text-base text-gray-500 dark:text-gray-400">{ u.CreatedAt }</td>
	<td class="p-4 whitespace-nowrap">
		<div class="flex items-center justify-end gap-2">
			<a href={ "/admin/users/" + u.ID + "/edit" } class="inline-flex items-center rounded-lg bg-indigo-600 px-3 py-2 text-sm font-medium text-white hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-600">
				<svg class="mr-2 h-4 w-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M17.414 2.586a2 2 0 00-2.828 0L7 10.172V13h2.828l7.586-7.586a2 2 0 000-2.828z"></path><path fill-rule="evenodd" d="M2 6a2 2 0 012-2h4a1 1 0 010 2H4v10h10v-4a1 1 0 112 0v4a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" clip-rule="evenodd"></path></svg>
				Edit user
			</a>
			<button type="button" hx-post={ "/admin/users/" + u.ID + "/status" } hx-target="closest tr" hx-swap="outerHTML" class={ "inline-flex items-center rounded-lg px-3 py-2 text-sm font-medium text-white focus:ring-4 dark:focus:ring-red-900 " + userToggleClass(u.Active) }>
				<svg class="mr-2 h-4 w-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"></path></svg>
				{ userToggleLabel(u.Active) }
			</button>
		</div>
	</td>
}

// userPager renders the shared flowbite pager with the users list
// htmx wiring.
templ userPager(q string, page int, total int64, shown int64) {
	@components.Pager(components.PagerData{
		Total: total, Shown: shown, Page: page, PageSize: userPageSize,
		PrevHref: userPageHref(q, page-1), NextHref: userPageHref(q, page+1),
		PrevDisabled: page <= 1, NextDisabled: int64(page)*userPageSize >= total,
		HxGet: "/admin/users", HxInclude: "#user-search", HxTarget: "#user-list",
		HxValsPrev: userPageVals(page - 1), HxValsNext: userPageVals(page + 1),
	})
}

func userPageHref(q string, page int) string {
	href := "/admin/users?page=" + itoaUser(page)
	if q != "" {
		href += "&q=" + url.QueryEscape(q)
	}
	return href
}

func userPageVals(page int) string {
	return `{"page":` + itoaUser(page) + `}`
}

func userToggleClass(active int64) string {
	if active == 1 {
		return "bg-red-600 hover:bg-red-700 dark:bg-red-500"
	}
	return "bg-green-600 hover:bg-green-700 dark:bg-green-500"
}

func userToggleLabel(active int64) string {
	if active == 1 {
		return "Deactivate"
	}
	return "Activate"
}

templ userStatusCell(u UserListRow) {
	<div class="flex items-center">
		if u.Active == 1 {
			<span class="mr-2 h-2.5 w-2.5 rounded-full bg-green-400 dark:bg-green-500"></span>
			<span class="text-base font-normal text-gray-900 dark:text-white">Active</span>
		} else {
			<span class="mr-2 h-2.5 w-2.5 rounded-full bg-red-500"></span>
			<span class="text-base font-normal text-gray-900 dark:text-white">Inactive</span>
		}
	</div>
}

// UserFormPage renders the create (id empty) or edit form with the
// specialty checkboxes.
templ UserFormPage(token string, p *auth.Principal, id string, values UserFormValues, roles []RoleView, specialties []SpecialtyView, errMsg string) {
	@layouts.App(userFormTitle(id), token, p, "users") {
		<div class="mx-auto max-w-xl p-4 lg:p-6">
			@components.Card() {
				@components.CardHeader(userFormTitle(id)) {
					<a class="inline-flex items-center rounded-lg p-2 text-sm font-medium text-indigo-700 hover:bg-gray-100 dark:text-indigo-400 dark:hover:bg-gray-700" href="/admin/users">Back to users</a>
				}
				@UserForm(token, id, values, roles, specialties, errMsg)
			}
		</div>
	}
}

// UserForm is the account form fragment: htmx posts replace it in place
// so validation errors keep the typed values. The specialty checkboxes
// are shown when the catalog has entries, so a physician can carry more
// than one specialty.
templ UserForm(token string, id string, values UserFormValues, roles []RoleView, specialties []SpecialtyView, errMsg string) {
	<form method="post" action={ userFormAction(id) } hx-post={ userFormAction(id) } hx-target="this" hx-swap="outerHTML" class="space-y-4">
		<input type="hidden" name="_csrf" value={ token }>
		if errMsg != "" {
			@components.Alert(errMsg, false)
		}
		@components.Field("name", "Name") {
			@components.Input("name", "", templ.Attributes{ "id": "name", "type": "text", "value": values.Name, "required": true, "autofocus": true })
		}
		@components.Field("email", "Email") {
			@components.Input("email", "", templ.Attributes{ "id": "email", "type": "email", "value": values.Email, "required": true })
		}
		if id == "" {
			@components.Field("password", "Password") {
				@components.Input("password", "", templ.Attributes{ "id": "password", "type": "password", "minlength": "8", "required": true })
			}
		}
		@components.Field("role", "Role") {
			@components.Select("role", "", templ.Attributes{ "id": "role", "required": true }) {
				for _, r := range roles {
					@roleOption(r.Name, r.Name, values.Role)
				}
			}
		}
		if id != "" {
			<div class="flex items-center gap-2">
				@components.Checkbox("active", "", templ.Attributes{ "id": "active", "checked": values.Active })
				<label class="text-sm text-gray-700 dark:text-gray-300" for="active">Active account</label>
			</div>
		}
		if len(specialties) > 0 {
			<fieldset>
				<legend class="text-sm font-semibold text-gray-900 dark:text-white">Specialties</legend>
				<p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">A clinician can have more than one.</p>
				<div class="mt-2 grid grid-cols-1 gap-2 sm:grid-cols-2">
					for _, sp := range specialties {
						<label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
							@components.Checkbox("specialties", "", templ.Attributes{ "value": sp.ID, "checked": sp.Selected })
							{ sp.Name }
						</label>
					}
				</div>
			</fieldset>
		}
		<div class="flex items-center gap-3">
			@components.Button("primary", userFormSubmit(id), templ.Attributes{ "type": "submit" })
			@components.ButtonLink("secondary", "/admin/users", "Cancel", templ.Attributes{ "hx-target": "body" })
		</div>
	</form>
}

templ roleOption(value string, label string, selected string) {
	if value == selected {
		<option value={ value } selected>{ label }</option>
	} else {
		<option value={ value }>{ label }</option>
	}
}

const userPageSize = 20

func itoaUser(n int) string {
	return strconv.Itoa(n)
}

func userFormTitle(id string) string {
	if id == "" {
		return "New user"
	}
	return "Edit user"
}

func userFormAction(id string) string {
	if id == "" {
		return "/admin/users"
	}
	return "/admin/users/" + id
}

func userFormSubmit(id string) string {
	if id == "" {
		return "Create user"
	}
	return "Save changes"
}
