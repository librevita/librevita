package views

import (
	"librevita.org/internal/core/auth"
	"librevita.org/internal/ui/components"
	"librevita.org/internal/ui/layouts"
)

// PatientRow is a patient decorated for the list table.
type PatientRow struct {
	ID          string
	DisplayName string
	BirthDate   string
	Sex         string
	Document    string
	Phone       string
	Email       string
	City        string
	Status      string
	CreatedAt   string
}

// PatientListPage renders the patient registry with search. The search
// input targets the list fragment, so the page body and the fragment
// share the same table markup.
templ PatientListPage(token string, p *auth.Principal, q string, patients []PatientRow, errMsg string) {
	@layouts.App("Patients", token, p, "patients") {
		<div class="mx-auto max-w-6xl">
			<div class="flex items-center justify-between">
				<h2 class="text-lg font-semibold text-gray-900 dark:text-white">Patient registry</h2>
				<a class="btn" href="/patients/new">New patient</a>
			</div>
			<div class="mt-4">
				@patientSearchInput(q)
				<div id="patient-list" class="mt-4">
					@PatientListTable(patients, errMsg)
				</div>
			</div>
		</div>
	}
}

// PatientListTable is the fragment swapped by the search input and the
// archive actions.
templ PatientListTable(patients []PatientRow, errMsg string) {
	if errMsg != "" {
		@components.Alert(errMsg, false)
	}
	if len(patients) == 0 {
		<div class="rounded-lg border border-gray-200 bg-white p-6 text-center shadow-sm dark:border-gray-700 dark:bg-gray-800">
			<p class="text-sm text-gray-500 dark:text-gray-400">No patients found.</p>
		</div>
	} else {
		<div class="overflow-x-auto rounded-lg">
			<table class="min-w-full divide-y divide-gray-200 text-sm">
				@components.Thead() {
					<tr>
						@components.Th("Patient", "p-4")
						@components.Th("Birth date", "p-4")
						@components.Th("Document", "p-4")
						@components.Th("Phone", "p-4")
						@components.Th("Status", "p-4")
						@components.Th("Actions", "p-4")
					</tr>
				}
				<tbody class="divide-y divide-gray-200 bg-white dark:divide-gray-700 dark:bg-gray-800">
					for _, pt := range patients {
						<tr>
							<td class="whitespace-nowrap p-4">
								<div class="flex items-center gap-3">
									@components.Avatar(components.Initials(pt.DisplayName), "h-8 w-8 bg-indigo-100 text-indigo-700 dark:bg-indigo-900 dark:text-indigo-300")
									<div class="min-w-0">
										<a class="truncate font-medium text-gray-900 hover:text-indigo-600 dark:text-white dark:hover:text-indigo-400" href={ "/patients/" + pt.ID }>{ pt.DisplayName }</a>
										if pt.Email != "" {
											<p class="truncate text-xs text-gray-500 dark:text-gray-400">{ pt.Email }</p>
										}
									</div>
								</div>
							</td>
							<td class="whitespace-nowrap p-4 font-normal text-gray-500 dark:text-gray-400">{ orDash(pt.BirthDate) }</td>
							<td class="whitespace-nowrap p-4 font-normal text-gray-500 dark:text-gray-400">{ orDash(pt.Document) }</td>
							<td class="whitespace-nowrap p-4 font-normal text-gray-500 dark:text-gray-400">{ orDash(pt.Phone) }</td>
							<td class="whitespace-nowrap p-4">@statusBadge(pt.Status)</td>
							<td class="whitespace-nowrap p-4">
								<div class="flex items-center gap-2">
									<a class="inline-flex items-center rounded-md px-2 py-1 text-sm font-medium text-indigo-700 hover:bg-gray-100 dark:text-indigo-400 dark:hover:bg-gray-700" href={ "/patients/" + pt.ID + "/edit" }>Edit</a>
									if pt.Status == "active" {
										<button type="button" hx-post={ "/patients/" + pt.ID + "/archive" } hx-target="closest tr" hx-swap="outerHTML" class="inline-flex items-center rounded-md px-2 py-1 text-sm font-medium text-gray-500 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-700">Archive</button>
									} else {
										<button type="button" hx-post={ "/patients/" + pt.ID + "/restore" } hx-target="closest tr" hx-swap="outerHTML" class="inline-flex items-center rounded-md px-2 py-1 text-sm font-medium text-green-700 hover:bg-gray-100 dark:text-green-400 dark:hover:bg-gray-700">Restore</button>
									}
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ patientSearchInput(q string) {
	<div class="relative">
		<label class="sr-only" for="patient-search">Search patients</label>
		<input id="patient-search" class="auth-input pl-10" type="search" name="q" value={ q } placeholder="Search by name, document, or email..."
			hx-get="/patients" hx-trigger="input changed delay:300ms" hx-target="#patient-list" hx-swap="innerHTML">
		<svg class="pointer-events-none absolute inset-y-0 left-3 my-auto h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
			<path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
		</svg>
	</div>
}

func orDash(s string) string {
	if s == "" {
		return "-"
	}
	return s
}

templ statusBadge(status string) {
	if status == "active" {
		<span class="rounded-md bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-800 dark:bg-green-900 dark:text-green-300">active</span>
	} else {
		<span class="rounded-md bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-800 dark:bg-gray-700 dark:text-gray-300">inactive</span>
	}
}
