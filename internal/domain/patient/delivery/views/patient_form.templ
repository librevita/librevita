package views

import (
	"librevita.org/internal/ui/shared"
	"librevita.org/internal/core/auth"
	"librevita.org/internal/domain/patient/repository"
	"librevita.org/internal/ui/components"
	"librevita.org/internal/ui/layouts"
)

// PatientFormValues carries the current field values, so the form can
// redraw with the user's input after a validation error.
type PatientFormValues struct {
	DisplayName string
	BirthDate   string
	Sex         string
	Document    string
	Phone       string
	Email       string
	Street      string
	City        string
	State       string
	PostalCode  string
	Notes       string
}

// PatientFormPage renders the create (id empty) or edit page.
templ PatientFormPage(token string, p *auth.Principal, id string, values PatientFormValues, errMsg string) {
	@layouts.App(patientFormTitle(id), token, p, "patients") {
		<div class="mx-auto max-w-3xl">
			@components.Card() {
				@components.CardHeader(patientFormTitle(id)) {
					<a class="inline-flex items-center rounded-lg p-2 text-sm font-medium text-indigo-700 hover:bg-gray-100 dark:text-indigo-400 dark:hover:bg-gray-700" href="/patients">Back to registry</a>
				}
				@PatientForm(token, id, values, errMsg)
			}
		</div>
	}
}

// PatientForm is the form fragment: htmx posts replace it in place so
// validation errors keep the typed values, and the document field checks
// duplicates on blur.
templ PatientForm(token string, id string, values PatientFormValues, errMsg string) {
	<form method="post" action={ patientFormAction(id) } hx-post={ patientFormAction(id) } hx-target="this" hx-swap="outerHTML" class="space-y-6">
		<input type="hidden" name="_csrf" value={ token }>
		<input type="hidden" name="id" id="patient-id" value={ id }>
		if errMsg != "" {
			<div class="mb-4">@components.Alert(errMsg, false)</div>
		}
		<fieldset class="space-y-4">
			<legend class="text-sm font-semibold text-gray-900 dark:text-white">Identity</legend>
			@components.Field("display_name", "Full name") {
				@components.Input("display_name", templ.Attributes{ "id": "display_name", "type": "text", "value": values.DisplayName, "required": true, "autofocus": true })
			}
			<div class="flex flex-wrap gap-4">
				<div class="flex-1">
					@components.Field("birth_date", "Birth date") {
						@components.Input("birth_date", templ.Attributes{ "id": "birth_date", "type": "date", "value": values.BirthDate })
					}
				</div>
				<div class="flex-1">
					@components.Field("sex", "Sex") {
						@components.Select("sex", templ.Attributes{ "id": "sex" }) {
							@sexOption("unknown", "Not specified", values.Sex)
							@sexOption("female", "Female", values.Sex)
							@sexOption("male", "Male", values.Sex)
							@sexOption("other", "Other", values.Sex)
						}
					}
				</div>
			</div>
			<div class="flex flex-wrap gap-4">
				<div class="flex-1">
					@components.Field("document", "Document") {
						@components.Input("document", templ.Attributes{ "id": "document", "type": "text", "value": values.Document, "hx-post": "/patients/check-document", "hx-trigger": "blur changed", "hx-include": "#patient-id", "hx-target": "#document-error", "hx-swap": "innerHTML" })
						<p id="document-error" class="mt-1 text-xs text-red-600 dark:text-red-400"></p>
					}
				</div>
				<div class="flex-1">
					@components.Field("phone", "Phone") {
						@components.Input("phone", templ.Attributes{ "id": "phone", "type": "tel", "value": values.Phone })
					}
				</div>
			</div>
			@components.Field("email", "Email") {
				@components.Input("email", templ.Attributes{ "id": "email", "type": "email", "value": values.Email })
			}
		</fieldset>
		<fieldset class="space-y-4">
			<legend class="text-sm font-semibold text-gray-900 dark:text-white">Address</legend>
			@components.Field("street", "Street") {
				@components.Input("street", templ.Attributes{ "id": "street", "type": "text", "value": values.Street })
			}
			<div class="flex flex-wrap gap-4">
				<div class="flex-1">
					@components.Field("city", "City") {
						@components.Input("city", templ.Attributes{ "id": "city", "type": "text", "value": values.City })
					}
				</div>
				<div class="flex-1">
					@components.Field("state", "State") {
						@components.Input("state", templ.Attributes{ "id": "state", "type": "text", "value": values.State })
					}
				</div>
				<div class="flex-1">
					@components.Field("postal_code", "Postal code") {
						@components.Input("postal_code", templ.Attributes{ "id": "postal_code", "type": "text", "value": values.PostalCode })
					}
				</div>
			</div>
		</fieldset>
		<fieldset class="space-y-4">
			<legend class="text-sm font-semibold text-gray-900 dark:text-white">Notes</legend>
			@components.Textarea("notes", templ.Attributes{ "id": "notes", "rows": "4" }) {
				{ values.Notes }
			}
		</fieldset>
		<div class="flex items-center gap-3">
			@components.Button("primary", patientFormSubmit(id), templ.Attributes{ "type": "submit" })
			@components.ButtonLink("secondary", "/patients", "Cancel", templ.Attributes{ "hx-target": "body" })
		</div>
	</form>
}

templ sexOption(value string, label string, selected string) {
	if value == selected {
		<option value={ value } selected>{ label }</option>
	} else {
		<option value={ value }>{ label }</option>
	}
}

func patientFormTitle(id string) string {
	if id == "" {
		return "New patient"
	}
	return "Edit patient"
}

func patientFormAction(id string) string {
	if id == "" {
		return "/patients"
	}
	return "/patients/" + id
}

func patientFormSubmit(id string) string {
	if id == "" {
		return "Create patient"
	}
	return "Save changes"
}

// HistoryRow is one line of the patient's change history, pre-rendered
// by the handler (timezone and actor formatting).
type HistoryRow struct {
	When string
	Text string
}

// PatientDetailPage renders the patient record with the registrar and
// the change history.
templ PatientDetailPage(token string, p *auth.Principal, pt *repository.GetPatientWithCreatorRow, createdBy string, history []HistoryRow, errMsg string) {
	@layouts.App("Patient", token, p, "patients") {
		<div class="mx-auto max-w-4xl">
			@components.Card() {
				@components.CardHeader(pt.DisplayName) {
					<a class="inline-flex items-center rounded-lg p-2 text-sm font-medium text-indigo-700 hover:bg-gray-100 dark:text-indigo-400 dark:hover:bg-gray-700" href="/patients">Back to registry</a>
				}
				if errMsg != "" {
					<div class="mb-4">@components.Alert(errMsg, false)</div>
				}
				<div class="flex items-center gap-4">
					@components.Avatar(shared.Initials(pt.DisplayName), "h-16 w-16 bg-indigo-600 text-white text-xl")
					<div>
						<p class="text-sm text-gray-500 dark:text-gray-400">Registered { pt.CreatedAt }</p>
						if createdBy != "" {
							<p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">by <span class="font-medium text-gray-700 dark:text-gray-300">{ createdBy }</span></p>
						}
						<p class="mt-1 text-xs text-gray-400 dark:text-gray-400">Updated { pt.UpdatedAt }</p>
					</div>
					<div class="ml-auto">@patientStatusBadge(pt.Status)</div>
				</div>
				<dl class="mt-6 grid grid-cols-1 gap-4 text-sm sm:grid-cols-2">
					@detailField("Birth date", orEmpty(pt.BirthDate))
					@detailField("Sex", pt.Sex)
					@detailField("Document", orEmpty(pt.Document))
					@detailField("Phone", orEmpty(pt.Phone))
					@detailField("Email", orEmpty(pt.Email))
					@detailField("Address", addressLine(pt))
				</dl>
				if pt.Notes != nil {
					<div class="mt-6">
						<h4 class="text-sm font-semibold text-gray-900 dark:text-white">Notes</h4>
						<p class="mt-2 whitespace-pre-wrap text-sm text-gray-600 dark:text-gray-300">{ *pt.Notes }</p>
					</div>
				}
				<div class="mt-6 flex items-center gap-3">
					@components.ButtonLink("primary", "/patients/" + pt.ID + "/edit", "Edit patient", nil)
					<form method="post" action={ "/patients/" + pt.ID + "/archive" }>
						<input type="hidden" name="_csrf" value={ token }>
						@components.Button("secondary", "Archive", templ.Attributes{ "type": "submit" })
					</form>
				</div>
				if len(history) > 0 {
					<div class="mt-8">
						<h4 class="text-sm font-semibold text-gray-900 dark:text-white">History</h4>
						<ul class="mt-3 divide-y divide-gray-200 dark:divide-gray-700">
							for _, h := range history {
								<li class="flex items-baseline gap-4 py-2 text-sm">
									<span class="w-36 shrink-0 text-xs text-gray-500 dark:text-gray-400">{ h.When }</span>
									<span class="text-gray-700 dark:text-gray-300">{ h.Text }</span>
								</li>
							}
						</ul>
					</div>
				}
			}
		</div>
	}
}

templ detailField(label string, value string) {
	<div>
		<dt class="text-gray-500 dark:text-gray-400">{ label }</dt>
		<dd class="mt-0.5 font-medium text-gray-900 dark:text-white">{ orDash(value) }</dd>
	</div>
}

templ patientStatusBadge(status string) {
	@statusBadge(status)
}

func addressLine(pt *repository.GetPatientWithCreatorRow) string {
	parts := []string{orEmpty(pt.Street), orEmpty(pt.City), orEmpty(pt.State), orEmpty(pt.PostalCode)}
	out := ""
	for _, part := range parts {
		if part == "" {
			continue
		}
		if out != "" {
			out += ", "
		}
		out += part
	}
	return out
}

// PatientDocumentError is the inline duplicate-document message swapped
// into the #document-error container. The id keeps the target stable
// across swaps.
templ PatientDocumentError(message string) {
	<p id="document-error" class="mt-1 text-xs text-red-600 dark:text-red-400">{ message }</p>
}
