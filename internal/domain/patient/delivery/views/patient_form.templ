package views

import (
	"strconv"

	"librevita.org/internal/ui/shared"
	"librevita.org/internal/core/auth"
	"librevita.org/internal/domain/patient/repository"
	"librevita.org/internal/ui/components"
	"librevita.org/internal/ui/layouts"
)

// PatientFormValues carries the current field values, so the form can
// redraw with the user's input after a validation error.
type PatientFormValues struct {
	DisplayName      string
	BirthDate        string
	Sex              string
	Phone            string
	Email            string
	Street           string
	City             string
	State            string
	PostalCode       string
	Notes            string
	IdentifierSystem string
	IdentifierValue  string
}

// PatientFormPage renders the create (id empty) or edit page.
templ PatientFormPage(token string, p *auth.Principal, id string, systems []SystemOption, values PatientFormValues, errMsg string) {
	@layouts.App(patientFormTitle(id), token, p, "patients") {
		<div class="mx-auto max-w-3xl p-4 lg:p-6">
			@components.Card() {
				@components.CardHeader(patientFormTitle(id)) {
					<a class="inline-flex items-center rounded-lg p-2 text-sm font-medium text-indigo-700 hover:bg-gray-100 dark:text-indigo-400 dark:hover:bg-gray-700" href="/patients">Back to registry</a>
				}
				@PatientForm(token, id, systems, values, errMsg)
			}
		</div>
	}
}

// PatientForm is the form fragment: htmx posts replace it in place so
// validation errors keep the typed values.
templ PatientForm(token string, id string, systems []SystemOption, values PatientFormValues, errMsg string) {
	<form method="post" action={ patientFormAction(id) } hx-post={ patientFormAction(id) } hx-target="this" hx-swap="outerHTML" class="space-y-6">
		<input type="hidden" name="_csrf" value={ token }>
		<input type="hidden" name="id" id="patient-id" value={ id }>
		if errMsg != "" {
			<div class="mb-4">@components.Alert(errMsg, false)</div>
		}
		<fieldset class="space-y-4">
			<legend class="text-sm font-semibold text-gray-900 dark:text-white">Identity</legend>
			@components.Field("display_name", "Full name") {
				@components.Input("display_name", "", templ.Attributes{ "id": "display_name", "type": "text", "value": values.DisplayName, "required": true, "autofocus": true })
			}
			<div class="flex flex-wrap gap-4">
				<div class="flex-1">
					@components.Field("birth_date", "Birth date") {
						@components.Datepicker("birth_date", "", templ.Attributes{ "id": "birth_date", "value": values.BirthDate })
					}
				</div>
				<div class="flex-1">
					@components.Field("sex", "Sex") {
						@components.Select("sex", "", templ.Attributes{ "id": "sex" }) {
							@sexOption("unknown", "Not specified", values.Sex)
							@sexOption("female", "Female", values.Sex)
							@sexOption("male", "Male", values.Sex)
							@sexOption("other", "Other", values.Sex)
						}
					}
				</div>
			</div>
			<div class="flex flex-wrap gap-4">
				<div class="flex-1">
					@components.Field("identifier_system", "Identification document type") {
						@components.Select("identifier_system", "", templ.Attributes{ "id": "identifier_system" }) {
							@identifierSystemOption("", "Detect automatically", values.IdentifierSystem)
							for _, s := range systems {
								@identifierSystemOption(s.System, s.DisplayName, values.IdentifierSystem)
							}
						}
					}
				</div>
				<div class="flex-1">
					@components.Field("identifier_value", "Identification document") {
						@components.Input("identifier_value", "", templ.Attributes{ "id": "identifier_value", "type": "text", "value": values.IdentifierValue, "placeholder": "CPF, SUS, NIF, passport..." })
						<p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Stored encrypted; duplicates are rejected across the deployment.</p>
					}
				</div>
			</div>
			<div class="flex flex-wrap gap-4">
				<div class="flex-1">
					@components.Field("phone", "Phone") {
						@components.Input("phone", "", templ.Attributes{ "id": "phone", "type": "tel", "value": values.Phone })
					}
				</div>
				<div class="flex-1">
					@components.Field("email", "Email") {
						@components.Input("email", "", templ.Attributes{ "id": "email", "type": "email", "value": values.Email })
					}
				</div>
			</div>
		</fieldset>
		<fieldset class="space-y-4">
			<legend class="text-sm font-semibold text-gray-900 dark:text-white">Address</legend>
			@components.Field("street", "Street") {
				@components.Input("street", "", templ.Attributes{ "id": "street", "type": "text", "value": values.Street })
			}
			<div class="flex flex-wrap gap-4">
				<div class="flex-1">
					@components.Field("city", "City") {
						@components.Input("city", "", templ.Attributes{ "id": "city", "type": "text", "value": values.City })
					}
				</div>
				<div class="flex-1">
					@components.Field("state", "State") {
						@components.Input("state", "", templ.Attributes{ "id": "state", "type": "text", "value": values.State })
					}
				</div>
				<div class="flex-1">
					@components.Field("postal_code", "Postal code") {
						@components.Input("postal_code", "", templ.Attributes{ "id": "postal_code", "type": "text", "value": values.PostalCode })
					}
				</div>
			</div>
		</fieldset>
		<fieldset class="space-y-4">
			<legend class="text-sm font-semibold text-gray-900 dark:text-white">Notes</legend>
			@components.Textarea("notes", "", templ.Attributes{ "id": "notes", "rows": "4" }) {
				{ values.Notes }
			}
		</fieldset>
		<div class="flex items-center gap-3">
			@components.Button("primary", patientFormSubmit(id), templ.Attributes{ "type": "submit" })
			@components.ButtonLink("secondary", "/patients", "Cancel", templ.Attributes{ "hx-target": "body" })
		</div>
	</form>
}

templ sexOption(value string, label string, selected string) {
	if value == selected {
		<option value={ value } selected>{ label }</option>
	} else {
		<option value={ value }>{ label }</option>
	}
}

templ identifierSystemOption(value string, label string, selected string) {
	if value == selected {
		<option value={ value } selected>{ label }</option>
	} else {
		<option value={ value }>{ label }</option>
	}
}

func patientFormTitle(id string) string {
	if id == "" {
		return "New patient"
	}
	return "Edit patient"
}

func patientFormAction(id string) string {
	if id == "" {
		return "/patients"
	}
	return "/patients/" + id
}

func patientFormSubmit(id string) string {
	if id == "" {
		return "Create patient"
	}
	return "Save changes"
}

// HistoryRow is one line of the patient's change history, pre-rendered
// by the handler (timezone and actor formatting).
type HistoryRow struct {
	When string
	Text string
}

// PatientDetailPage renders the patient record with the registrar and
// the change history.
templ PatientDetailPage(token string, p *auth.Principal, pt *repository.GetPatientWithCreatorRow, createdAt, updatedAt, createdBy string, history []HistoryRow, docs []DocumentRow, ids []IdentifierRow, systems []SystemOption, errMsg string) {
	@layouts.App("Patient", token, p, "patients") {
		<div class="mx-auto max-w-4xl p-4 lg:p-6">
			@components.Card() {
				@components.CardHeader(pt.DisplayName) {
					<a class="inline-flex items-center rounded-lg p-2 text-sm font-medium text-indigo-700 hover:bg-gray-100 dark:text-indigo-400 dark:hover:bg-gray-700" href="/patients">Back to registry</a>
				}
				if errMsg != "" {
					<div class="mb-4">@components.Alert(errMsg, false)</div>
				}
				<div class="flex items-center gap-4">
					@components.Avatar(shared.Initials(pt.DisplayName), "h-16 w-16 bg-indigo-600 text-white text-xl")
					<div>
						<p class="text-sm text-gray-500 dark:text-gray-400">Registered { createdAt }</p>
						if createdBy != "" {
							<p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">by <span class="font-medium text-gray-700 dark:text-gray-300">{ createdBy }</span></p>
						}
						<p class="mt-1 text-xs text-gray-400 dark:text-gray-400">Updated { updatedAt }</p>
					</div>
					<div class="ml-auto">@patientStatusBadge(pt.Status)</div>
				</div>
				<dl class="mt-6 flex flex-col space-y-4 text-sm sm:flex-row sm:flex-wrap sm:space-y-0 sm:-mx-2">
					@detailField("Birth date", orEmpty(pt.BirthDate))
					@detailField("Sex", pt.Sex)
					@detailField("Phone", orEmpty(pt.Phone))
					@detailField("Email", orEmpty(pt.Email))
					@detailField("Address", addressLine(pt))
				</dl>
				if pt.Notes != nil {
					<div class="mt-6">
						<h4 class="text-sm font-semibold text-gray-900 dark:text-white">Notes</h4>
						<p class="mt-2 whitespace-pre-wrap text-sm text-gray-600 dark:text-gray-300">{ *pt.Notes }</p>
					</div>
				}
				<div class="mt-6 flex items-center gap-3">
					@components.ButtonLink("primary", "/patients/" + pt.ID.String() + "/edit", "Edit patient", nil)
					<form method="post" action={ "/patients/" + pt.ID.String() + "/archive" }>
						<input type="hidden" name="_csrf" value={ token }>
						@components.Button("secondary", "Archive", templ.Attributes{ "type": "submit" })
					</form>
				</div>
				if len(history) > 0 {
					<div class="mt-8">
						<h4 class="text-sm font-semibold text-gray-900 dark:text-white">History</h4>
						<ul class="mt-3 divide-y divide-gray-200 dark:divide-gray-700">
							for _, h := range history {
								<li class="flex items-baseline gap-4 py-2 text-sm">
									<span class="w-36 shrink-0 text-xs text-gray-500 dark:text-gray-400">{ h.When }</span>
									<span class="text-gray-700 dark:text-gray-300">{ h.Text }</span>
								</li>
							}
						</ul>
					</div>
				}
			}
			@PatientIdentifiersSection(token, pt.ID.String(), ids, systems, "")
			<section class="mt-4 rounded-lg border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-gray-800">
				<div class="flex items-center justify-between gap-4">
					<div>
						<h3 class="text-base font-semibold text-gray-900 dark:text-white">Documents</h3>
						<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Clinical attachments of this patient. Every download is audited.</p>
					</div>
					@components.Badge(strconv.Itoa(len(docs)))
				</div>
				<ul class="mt-4 divide-y divide-gray-200 dark:divide-gray-700">
					for _, doc := range docs {
						<li class="flex items-center gap-4 py-3">
							<svg class="h-8 w-8 shrink-0 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
							</svg>
							<div class="min-w-0 flex-1">
								<p class="truncate text-sm font-medium text-gray-900 dark:text-white">{ doc.OriginalName }</p>
								<p class="text-xs text-gray-500 dark:text-gray-400">{ formatSize(doc.Size) } · { doc.UploadedAt }</p>
							</div>
							@components.ButtonLink("secondary", "/patients/" + pt.ID.String() + "/documents/" + doc.ID, "Download", templ.Attributes{ "download": "" })
						</li>
					}
				</ul>
				<form method="post" enctype="multipart/form-data" action={ "/patients/" + pt.ID.String() + "/documents" } class="mt-4 flex flex-wrap items-center gap-3 border-t border-gray-200 pt-4 dark:border-gray-700">
					<input type="hidden" name="_csrf" value={ token }>
					<input type="file" name="file" class="block w-full max-w-sm text-sm text-gray-700 file:mr-3 file:rounded-lg file:border-0 file:bg-indigo-600 file:px-4 file:py-2 file:text-sm file:font-medium file:text-white hover:file:bg-indigo-700 dark:text-gray-300 dark:file:bg-indigo-500" required>
					@components.Button("primary", "Upload", templ.Attributes{ "type": "submit" })
				</form>
			</section>
		</div>
	}
}

// DocumentRow is one attachment of the patient documents list.
type DocumentRow struct {
	ID           string
	OriginalName string
	ContentType  string
	Size         int64
	UploadedAt   string
}

// formatSize renders a byte count in a human-readable unit.
func formatSize(size int64) string {
	switch {
	case size >= 1<<20:
		return strconv.FormatInt(size>>20, 10) + " MB"
	case size >= 1<<10:
		return strconv.FormatInt(size>>10, 10) + " KB"
	default:
		return strconv.FormatInt(size, 10) + " B"
	}
}

templ detailField(label string, value string) {
	<div class="sm:w-1/2 sm:px-2">
		<dt class="text-gray-500 dark:text-gray-400">{ label }</dt>
		<dd class="mt-0.5 font-medium text-gray-900 dark:text-white">{ orDash(value) }</dd>
	</div>
}

templ patientStatusBadge(status string) {
	<div class="flex items-center">
		if status == "active" {
			<span class="mr-2 h-2.5 w-2.5 rounded-full bg-green-400 dark:bg-green-500"></span>
			<span class="text-sm text-gray-900 dark:text-white">Active</span>
		} else {
			<span class="mr-2 h-2.5 w-2.5 rounded-full bg-red-500"></span>
			<span class="text-sm text-gray-900 dark:text-white">Inactive</span>
		}
	</div>
}

func addressLine(pt *repository.GetPatientWithCreatorRow) string {
	parts := []string{orEmpty(pt.Street), orEmpty(pt.City), orEmpty(pt.State), orEmpty(pt.PostalCode)}
	out := ""
	for _, part := range parts {
		if part == "" {
			continue
		}
		if out != "" {
			out += ", "
		}
		out += part
	}
	return out
}
