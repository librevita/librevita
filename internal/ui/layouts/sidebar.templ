package layouts

import (
	"librevita.org/internal/core/auth"
	"librevita.org/internal/ui/components"
)

// Sidebar is the navigation rail: role-aware link groups. It is a drawer
// on small screens (data-lv-drawer, <md), an icon-only rail on medium
// screens (data-lv-rail, md..xl) and a static full sidebar from xl up.
// The drawer and the desktop sidebar render the same navMenu, so the
// menu is identical at every size.
templ Sidebar(principal *auth.Principal, active string) {
	<div data-lv-backdrop x-show="open" x-cloak x-transition.opacity.duration.200ms @click="close()" class="fixed inset-0 z-30 bg-gray-900/50 md:!hidden" aria-hidden="true"></div>
	<aside data-lv-drawer x-show="open" x-cloak x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 -translate-x-full" x-transition:enter-end="opacity-100 translate-x-0" x-transition:leave="transition ease-in duration-200" x-transition:leave-start="opacity-100 translate-x-0" x-transition:leave-end="opacity-0 -translate-x-full" class="fixed bottom-0 left-0 top-16 z-40 w-64 flex-col overflow-y-auto border-r border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-800 md:!hidden">
		@navMenu(principal, active)
	</aside>
	<aside data-lv-rail class="hidden w-16 shrink-0 flex-col border-r border-gray-200 bg-white py-4 dark:border-gray-700 dark:bg-gray-800 md:flex xl:hidden">
		<nav class="flex flex-col items-center space-y-1">
			for _, section := range navSections(principal) {
				for _, item := range section.Items {
					@navIconLink(item, active == item.Active)
				}
			}
		</nav>
	</aside>
	<aside class="hidden w-64 shrink-0 flex-col overflow-y-auto border-r border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-800 xl:flex">
		@navMenu(principal, active)
	</aside>
}

// navMenu is the full sidebar menu (links with labels), shared by the
// mobile drawer and the desktop sidebar.
templ navMenu(principal *auth.Principal, active string) {
	<nav class="flex-1 space-y-6 px-3 py-4">
		for _, section := range navSections(principal) {
			<div class="space-y-1">
				<p class="px-3 pb-1 text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">{ section.Title }</p>
				for _, item := range section.Items {
					@navLink(item, active == item.Active)
				}
			</div>
		}
	</nav>
}

type navItem struct {
	Href   string
	Label  string
	Icon   string
	Active string
}

type navSection struct {
	Title string
	Items []navItem
}

func navSections(principal *auth.Principal) []navSection {
	general := []navItem{
		{"/", "Dashboard", "home", "dashboard"},
		{"/patients", "Patients", "person", "patients"},
	}
	if principal != nil && principal.Platform {
		return []navSection{{"General", []navItem{
			{"/", "Clinics", "home", "dashboard"},
			{"/clinics/new", "New clinic", "medical_services", "clinics"},
		}}}
	}
	if principal != nil && principal.Role != auth.RolePatient {
		general = append(general, navItem{"/calendar", "Calendar", "calendar_month", "calendar"})
		general = append(general, navItem{"/staff", "Physicians", "stethoscope", "physicians"})
	}
	if principal != nil && principal.Role == auth.RoleReceptionist {
		general = append(general, navItem{"/staff/my-requests", "My requests", "assignment", "my-requests"})
	}
	sections := []navSection{{"General", general}}
	if principal != nil && principal.Role == auth.RoleAdmin {
		sections = append(sections, navSection{"Management", []navItem{
			{"/users", "Users", "group", "users"},
			{"/specialties", "Specialties", "medical_services", "specialties"},
			{"/roles", "Roles", "shield", "roles"},
			{"/staff/requests", "Staff requests", "inbox", "staff-requests"},
			{"/identifier-systems", "Identifier systems", "fingerprint", "identifier-systems"},
			{"/policies", "Access policies", "policy", "policies"},
		}})
	}
	return sections
}

templ navLink(item navItem, active bool) {
	<a href={ item.Href } class={ navClass(active) }>
		@components.Icon(item.Icon, "h-6 w-6 shrink-0 text-gray-500 dark:text-gray-400")
		{ item.Label }
	</a>
}

templ navIconLink(item navItem, active bool) {
	<a href={ item.Href } title={ item.Label } aria-label={ item.Label } class={ railClass(active) }>
		@components.Icon(item.Icon, "h-6 w-6 shrink-0 text-gray-500 dark:text-gray-400")
	</a>
}

func navClass(active bool) string {
	base := "flex items-center space-x-3 rounded-lg px-3 py-2 text-base font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 "
	if active {
		return base + "bg-gray-100 text-gray-900 dark:bg-gray-700 dark:text-white"
	}
	return base + "text-gray-900 hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-700"
}

func railClass(active bool) string {
	base := "flex h-11 w-11 items-center justify-center rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 "
	if active {
		return base + "bg-gray-100 text-gray-900 dark:bg-gray-700 dark:text-white"
	}
	return base + "text-gray-500 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white"
}


