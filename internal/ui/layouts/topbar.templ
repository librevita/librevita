package layouts

import (
	"librevita.org/internal/core/auth"
	"librevita.org/internal/ui/components"
	"librevita.org/internal/ui/shared"
)

// Topbar is the full-width header: navigation toggle, brand, page title,
// and the user menu.
templ Topbar(title string, token string, principal *auth.Principal) {
	<header class="flex h-16 shrink-0 items-center justify-between border-b border-gray-200 bg-white px-3 dark:border-gray-700 dark:bg-gray-800 lg:px-5">
		<div class="flex items-center gap-3">
			<button type="button" data-lv-nav-toggle class="rounded-md p-2 text-gray-500 hover:bg-gray-100 hover:text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white md:hidden" aria-label="Toggle navigation">
				<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
				</svg>
			</button>
			<a href="/" class="flex items-center gap-2">
				@Logo("h-8 w-8 text-indigo-600 dark:text-indigo-400")
				<span class="text-xl font-semibold text-gray-900 dark:text-white">LibreVita</span>
			</a>
			<h1 class="ml-4 hidden border-l border-gray-200 pl-4 text-lg font-semibold text-gray-900 dark:border-gray-700 dark:text-white sm:block">{ title }</h1>
		</div>
		if principal != nil {
			<div class="relative">
				<button type="button" data-lv-user-menu-toggle class="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:hover:bg-gray-700" aria-haspopup="true" aria-expanded="false">
					@components.Avatar(shared.Initials(principal.Name), "h-8 w-8 bg-indigo-600 text-white")
					<span class="hidden text-sm font-medium text-gray-700 dark:text-gray-200 lg:block">{ principal.Name }</span>
					<svg class="hidden h-4 w-4 text-gray-400 dark:text-gray-500 lg:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
					</svg>
				</button>
				<div data-lv-user-menu class="absolute right-0 z-50 mt-2 hidden w-64 rounded-lg border border-gray-200 bg-white shadow-lg dark:border-gray-600 dark:bg-gray-800">
					<div class="border-b border-gray-200 px-4 py-3 dark:border-gray-600">
						<p class="text-sm font-medium text-gray-900 dark:text-white">{ principal.Name }</p>
						<p class="truncate text-xs text-gray-500 dark:text-gray-400">{ principal.Email }</p>
						<p class="mt-1 text-xs text-gray-400 dark:text-gray-400">Signed in as { principal.Role.String() }</p>
					</div>
					<div class="p-2">
						<a href="/profile" class="flex w-full items-center gap-2 rounded-md px-3 py-2 text-sm text-gray-700 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:text-gray-200 dark:hover:bg-gray-600">
							<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
							</svg>
							Profile
						</a>
					</div>
					<form method="post" hx-boost="false" action="/auth/logout" class="p-2">
						<input type="hidden" name="_csrf" value={ token }>
						<button type="submit" class="flex w-full items-center gap-2 rounded-md px-3 py-2 text-sm text-gray-700 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:text-gray-200 dark:hover:bg-gray-600">
							<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" />
							</svg>
							Sign out
						</button>
					</form>
				</div>
			</div>
		}
	</header>
}

// Logo is the LibreVita mark. Pass the svg class, e.g. "h-8 w-8
// text-indigo-600" for the topbar or "h-11 w-11 text-indigo-600" for the
// sign-in page.
templ Logo(svgClass string) {
	<svg class={ svgClass } fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
		<path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5" />
	</svg>
}
