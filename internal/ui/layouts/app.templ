package layouts

import (
	"strings"

	"librevita.org/internal/core/auth"
)

// App is the authenticated application shell: dark sidebar with the
// principal in the footer, a topbar with the user menu, and the page
// content. Interactions are progressive enhancements only; navigation is
// plain links.
templ App(title string, token string, principal *auth.Principal, active string) {
	@Base(title) {
		<div x-data="sidebar" class="flex h-full">
			<aside @click.outside="close()" x-show="open" class="fixed inset-y-0 left-0 z-40 flex w-64 flex-col bg-gray-800 md:static md:z-auto md:flex!">
				<div class="flex h-16 items-center gap-2 border-b border-gray-700 px-4">
					<svg class="h-7 w-7 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5" />
					</svg>
					<span class="text-lg font-semibold text-white">LibreVita</span>
				</div>
				<nav class="flex-1 space-y-6 overflow-y-auto px-3 py-4">
					<div class="space-y-1">
						<p class="px-3 pb-1 text-xs font-semibold uppercase tracking-wider text-gray-500">General</p>
						@navLink("/", "Dashboard", "dashboard", active == "dashboard")
					</div>
					if principal != nil && principal.Role == auth.RoleAdmin {
						<div class="space-y-1">
							<p class="px-3 pb-1 text-xs font-semibold uppercase tracking-wider text-gray-500">Management</p>
							@navLink("/admin", "Admin area", "admin", active == "admin")
							@navLink("/admin/policies", "Access policies", "policies", active == "policies")
						</div>
					}
				</nav>
				if principal != nil {
					<div class="flex items-center gap-3 border-t border-gray-700 px-4 py-3">
						<span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-indigo-600 text-xs font-semibold text-white">{ initials(principal.Name) }</span>
						<div class="min-w-0">
							<p class="truncate text-sm font-medium text-white">{ principal.Name }</p>
							<p class="truncate text-xs text-gray-400">{ principal.Email }</p>
						</div>
					</div>
				}
			</aside>
			<div class="flex min-w-0 flex-1 flex-col">
				<header class="flex h-16 shrink-0 items-center justify-between border-b border-gray-200 bg-white px-4 lg:px-6">
					<div class="flex items-center gap-3">
						<button type="button" @click="toggle()" class="rounded-md p-2 text-gray-500 hover:bg-gray-100 hover:text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 md:hidden" aria-label="Toggle navigation">
							<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
							</svg>
						</button>
						<h1 class="text-xl font-semibold text-gray-900">{ title }</h1>
					</div>
					if principal != nil {
						<div x-data="userMenu" class="relative">
							<button type="button" @click="toggle()" class="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500">
								<span class="flex h-8 w-8 items-center justify-center rounded-full bg-indigo-600 text-xs font-semibold text-white">{ initials(principal.Name) }</span>
								<span class="hidden text-sm font-medium text-gray-700 lg:block">{ principal.Name }</span>
								<svg class="hidden h-4 w-4 text-gray-400 lg:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
								</svg>
							</button>
							<div x-show="open" @click.outside="close()" class="absolute right-0 z-50 mt-2 w-64 rounded-lg border border-gray-200 bg-white shadow-lg">
								<div class="border-b border-gray-200 px-4 py-3">
									<p class="text-sm font-medium text-gray-900">{ principal.Name }</p>
									<p class="truncate text-xs text-gray-500">{ principal.Email }</p>
									<p class="mt-1 text-xs text-gray-400">Signed in as { principal.Role.String() }</p>
								</div>
								<form method="post" action="/auth/logout" class="p-2">
									<input type="hidden" name="_csrf" value={ token }>
									<button type="submit" class="flex w-full items-center gap-2 rounded-md px-3 py-2 text-sm text-gray-700 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500">
										<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
											<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" />
										</svg>
										Sign out
									</button>
								</form>
							</div>
						</div>
					}
				</header>
				<main class="flex-1 overflow-y-auto bg-gray-50 p-4 lg:p-6">
					{ children... }
				</main>
			</div>
		</div>
	}
}

templ navLink(href string, label string, icon string, active bool) {
	<a href={ href } class={ navClass(active) }>
		@navIcon(icon)
		{ label }
	</a>
}

func navClass(active bool) string {
	base := "flex items-center gap-3 rounded-md px-3 py-2 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 "
	if active {
		return base + "bg-gray-700 text-white"
	}
	return base + "text-gray-300 hover:bg-gray-700 hover:text-white"
}

templ navIcon(name string) {
	switch name {
	case "dashboard":
		<svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
			<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
		</svg>
	case "admin":
		<svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
			<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
		</svg>
	case "policies":
		<svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
			<path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
		</svg>
	}
}

func initials(name string) string {
	if name == "" {
		return "?"
	}
	parts := strings.Fields(name)
	if len(parts) == 1 {
		return strings.ToUpper(parts[0][:1])
	}
	return strings.ToUpper(parts[0][:1] + parts[1][:1])
}
