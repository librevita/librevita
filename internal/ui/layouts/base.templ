package layouts

import (
	"librevita.org/internal/types"
)

// Base is the bare document shell used by the anonymous pages (login,
// registration, setup). The UI theme comes from the authenticated
// shell; anonymous pages always follow the system scheme.
templ Base(title string, theme types.UITheme) {
	<!DOCTYPE html>
	<html lang="en" data-ui-theme={ theme.String() } class={ "h-full" + darkClass(theme) }>
		<head>
			<meta charset="utf-8">
			<meta name="viewport" content="width=device-width, initial-scale=1">
			<title>{ title } - LibreVita</title>
			<script src="/static/js/theme.js"></script>
			<link rel="stylesheet" href="/static/css/app.css">
			<script src="/static/js/htmx-1.9.12.min.js" defer></script>
			<script src="/static/js/htmx-sse-1.9.12.js" defer></script>
			<script src="/static/js/ui.js" defer></script>
		</head>
		<body hx-boost="true" class="h-full bg-gray-50 dark:bg-gray-900">
			{ children... }
		</body>
	</html>
}

// darkClass pre-applies the dark class when the theme is fixed dark, so
// the first paint is already dark before theme.js runs.
func darkClass(theme types.UITheme) string {
	if theme == types.UIThemeDark {
		return " dark"
	}
	return ""
}
