package layouts

templ Base(title string) {
	<!DOCTYPE html>
	<html lang="en" class="h-full bg-gray-50">
		<head>
			<meta charset="utf-8">
			<meta name="viewport" content="width=device-width, initial-scale=1">
			<title>{ title } - LibreVita</title>
			<link rel="stylesheet" href="/static/css/app.css">
			<script src="/static/js/htmx-1.9.12.min.js" defer></script>
			<script src="/static/js/htmx-sse-1.9.12.js" defer></script>
			<script src="/static/js/ui.js" defer></script>
			<script src="/static/js/alpine-csp-3.15.12.min.js" defer></script>
		</head>
		<body class="h-full">
			{ children... }
		</body>
	</html>
}
