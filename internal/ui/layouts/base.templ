package layouts

import (
	"librevita.org/internal/types"
	"librevita.org/internal/ui"
)

// Base is the bare document shell used by the anonymous pages (login,
// registration, setup). The UI theme comes from the authenticated
// shell; anonymous pages always follow the system scheme. The CSRF
// token rides in a meta tag so the JS can forward it on HTMX requests
// without reading the cookie (which is HttpOnly). The compiled assets
// have content-addressed names (see ui.AppCSS/ui.AppJS) — the single
// deferred bundle carries the HTMX runtime, its SSE extension and the
// application code — so everything under /static can be cached
// immutably. The theme bootstrap is rendered inline (allowed by its
// CSP content hash) so the dark class exists before first paint while
// the big bundle loads with defer.
templ Base(title string, theme types.UITheme, token string) {
	<!DOCTYPE html>
	<html lang="en" data-ui-theme={ theme.String() } class={ "h-full" + darkClass(theme) }>
		<head>
			<meta charset="utf-8">
			<meta name="viewport" content="width=device-width, initial-scale=1">
			<title>{ title } - LibreVita</title>
			if token != "" {
				<meta name="csrf-token" content={ token }>
			}
			@templ.Raw(themeTag(ui.ThemeScript))
			<link rel="stylesheet" href={ ui.AppCSS } integrity={ ui.AppCSSIntegrity }>
			<script src={ ui.AppJS } defer integrity={ ui.AppJSIntegrity }></script>
		</head>
		<body hx-boost="true" class="h-full bg-gray-50 dark:bg-gray-900">
			{ children... }
		</body>
	</html>
}

// darkClass pre-applies the dark class when the theme is fixed dark, so
// the first paint is already dark before the inline bootstrap runs.
func darkClass(theme types.UITheme) string {
	if theme == types.UIThemeDark {
		return " dark"
	}
	return ""
}

// themeTag wraps the theme bootstrap in its script element. The tag is
// rendered as raw HTML: inside a <script> element templ would treat the
// braces as a JavaScript expression and pass them through verbatim.
func themeTag(script string) string {
	return "<script>" + script + "</script>"
}
