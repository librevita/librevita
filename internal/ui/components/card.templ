package components

// Card is the standard white card shell used across the application
// pages. Auth pages keep the padded .card component from input.css.
templ Card() {
	<div class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm sm:p-6 dark:border-gray-700 dark:bg-gray-800">
		{ children... }
	</div>
}

// CardHeader renders the card title with optional trailing content.
templ CardHeader(title string) {
	<header class="mb-4 flex items-center justify-between">
		<h3 class="text-lg font-semibold text-gray-900 dark:text-white">{ title }</h3>
		{ children... }
	</header>
}
