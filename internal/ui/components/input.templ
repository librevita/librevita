package components

import "librevita.org/internal/ui/shared"

// Input renders a text-like control with the shared .input class plus
// any extra classes in extraClass (sizing, padding). Pass id, type,
// value, required and hx-* attributes in attrs; do not pass class.
templ Input(name string, extraClass string, attrs templ.Attributes) {
	<input name={ name } class={ shared.InputClass(extraClass) } { attrs... }>
}

// Select renders a select control; options go in the children.
templ Select(name string, extraClass string, attrs templ.Attributes) {
	<select name={ name } class={ shared.InputClass(extraClass) } { attrs... }>{ children... }</select>
}

// Textarea renders a multiline control; the text content goes in the
// children.
templ Textarea(name string, extraClass string, attrs templ.Attributes) {
	<textarea name={ name } class={ shared.InputClass(extraClass) } { attrs... }>{ children... }</textarea>
}

// Checkbox renders a checkbox with the standard accent color. Pass
// checked, value and other attributes in attrs.
templ Checkbox(name string, extraClass string, attrs templ.Attributes) {
	<input type="checkbox" name={ name } class={ shared.CheckboxClass(extraClass) } { attrs... }>
}
