package components

// Modal is the flowbite-style dialog: a dimmed backdrop, the card
// centered in the viewport, and the header with a close button. Open it
// with [data-lv-modal-open="#id"]; it closes via [data-lv-modal-close],
// clicking the backdrop or pressing Escape.
templ Modal(id string, title string, width string) {
	<div id={ id } tabindex="-1" aria-hidden="true" data-lv-modal class="fixed inset-0 z-50 hidden items-center justify-center overflow-y-auto p-4">
		<div class="absolute inset-0 bg-gray-900/50"></div>
		<div class={ "relative z-10 w-full rounded-lg bg-white shadow-xl dark:bg-gray-800 " + modalWidth(width) }>
			<div class="flex items-start justify-between rounded-t border-b border-gray-200 p-5 dark:border-gray-700">
				<h3 class="text-xl font-semibold text-gray-900 dark:text-white">{ title }</h3>
				<button type="button" data-lv-modal-close class="ml-auto inline-flex items-center rounded-lg bg-transparent p-1.5 text-sm text-gray-400 hover:bg-gray-200 hover:text-gray-900 dark:hover:bg-gray-700 dark:hover:text-white" aria-label="Close">
					<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
				</button>
			</div>
			<div class="p-6">
				{ children... }
			</div>
		</div>
	</div>
}

func modalWidth(width string) string {
	if width == "" {
		return "max-w-md"
	}
	return width
}
