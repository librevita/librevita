package components

// StatCard renders a label and value pair, used for the dashboard
// counters.
templ StatCard(label string, value int64) {
	<div class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-gray-800 sm:p-6">
		<h3 class="text-base font-normal text-gray-500 dark:text-gray-400">{ label }</h3>
		<p class="mt-1 text-2xl font-bold leading-none text-gray-900 dark:text-white sm:text-3xl">{ value }</p>
	</div>
}
