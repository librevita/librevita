package components

// DropdownMenu is the "three dots" action menu used in the table
// Actions columns. It toggles via data-lv-dropdown-toggle and closes on
// outside clicks or Escape; the items go in the children.
templ DropdownMenu() {
	<div class="relative" data-lv-dropdown>
		<button type="button" data-lv-dropdown-toggle class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-gray-300 bg-white text-gray-500 hover:bg-gray-50 hover:text-gray-900 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white" aria-label="Actions">
			<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 12h.01m6 0h.01m5.99 0h.01"></path></svg>
		</button>
		<div data-lv-dropdown-menu class="absolute right-0 z-20 mt-1 hidden w-44 rounded-lg border border-gray-200 bg-white shadow-lg dark:border-gray-600 dark:bg-gray-800">
			<ul class="p-1.5 text-sm font-medium text-gray-700 dark:text-gray-200">
				{ children... }
			</ul>
		</div>
	</div>
}

// DropdownItem is a link inside the action menu.
templ DropdownItem(href string, attrs templ.Attributes) {
	<li>
		<a href={ href } class="block w-full rounded-md p-2 hover:bg-gray-100 dark:hover:bg-gray-700" { attrs... }>{ children... }</a>
	</li>
}

// DropdownAction is a button inside the action menu (e.g. the status
// toggle); pass the hx-* attributes in attrs.
templ DropdownAction(attrs templ.Attributes) {
	<li>
		<button type="button" class="block w-full rounded-md p-2 text-left hover:bg-gray-100 dark:hover:bg-gray-700" { attrs... }>{ children... }</button>
	</li>
}
