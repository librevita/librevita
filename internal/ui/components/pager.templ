package components

import "strconv"

// PagerData carries the state for the number pagination shared by the
// list pages. Href builds the no-JS link for a page; HxVals the htmx
// page value (e.g. {"page":2}); the hx attributes refresh the table
// fragment.
type PagerData struct {
	Total    int64
	Shown    int64
	Page     int
	PageSize int

	Href   func(page int) string
	HxVals func(page int) string

	HxGet     string
	HxInclude string
	HxTarget  string
}

// Pager renders the pagination bar: a top divider spanning the table
// width and the number pagination (chevron arrows on the edges, a
// window of page numbers with ellipses in the middle) aligned to the
// right.
templ Pager(p PagerData) {
	if p.Total > 0 {
		<div class="sticky bottom-0 w-full border-t border-gray-200 bg-white p-4 sm:flex sm:justify-end dark:border-gray-800 dark:bg-gray-800">
			<div class="inline-flex -space-x-px" role="group">
				<a href={ p.Href(p.Page - 1) } hx-get={ p.HxGet } hx-vals={ p.HxVals(p.Page - 1) } hx-include={ p.HxInclude } hx-target={ p.HxTarget } hx-swap="innerHTML" aria-label="Previous page" class={ "inline-flex h-9 w-9 items-center justify-center rounded-l-lg border border-gray-300 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50 hover:text-gray-900 focus:outline-none dark:border-gray-600 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700 dark:hover:text-white " + pagerDisabled(p.Page <= 1) }>
					@Icon("chevron_left", "h-4 w-4")
				</a>
				for _, item := range pagesWindow(p.Page, p.totalPages()) {
					if item.Ellipsis {
						<span class="inline-flex h-9 w-9 items-center justify-center border border-gray-300 bg-white text-sm text-gray-500 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-400">...</span>
					} else {
						<a href={ p.Href(item.Page) } hx-get={ p.HxGet } hx-vals={ p.HxVals(item.Page) } hx-include={ p.HxInclude } hx-target={ p.HxTarget } hx-swap="innerHTML" class={ "inline-flex h-9 w-9 items-center justify-center border border-gray-300 text-sm font-medium focus:outline-none dark:border-gray-600 " + pagerNumberClass(item.Page == p.Page) }>{ item.Label }</a>
					}
				}
				<a href={ p.Href(p.Page + 1) } hx-get={ p.HxGet } hx-vals={ p.HxVals(p.Page + 1) } hx-include={ p.HxInclude } hx-target={ p.HxTarget } hx-swap="innerHTML" aria-label="Next page" class={ "inline-flex h-9 w-9 items-center justify-center rounded-r-lg border border-gray-300 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50 hover:text-gray-900 focus:outline-none dark:border-gray-600 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700 dark:hover:text-white " + pagerDisabled(p.Page >= p.totalPages()) }>
					@Icon("chevron_right", "h-4 w-4")
				</a>
			</div>
		</div>
	}
}

// totalPages returns the number of pages for the current page size.
func (p PagerData) totalPages() int {
	if p.PageSize <= 0 {
		return 1
	}
	return int((p.Total + int64(p.PageSize) - 1) / int64(p.PageSize))
}

// pageItem is one entry of the page window: a number or an ellipsis.
type pageItem struct {
	Label    string
	Page     int
	Ellipsis bool
}

// pagesWindow builds the visible page numbers around the current page:
// a window of three around it, expanded at the edges, with ellipses
// where the range jumps to the first or last page.
func pagesWindow(page, totalPages int) []pageItem {
	if totalPages <= 7 {
		out := make([]pageItem, 0, totalPages)
		for i := 1; i <= totalPages; i++ {
			out = append(out, pageItem{Label: strconv.Itoa(i), Page: i})
		}
		return out
	}
	start := page - 1
	end := page + 1
	if page <= 2 {
		end = 3
	}
	if page >= totalPages-1 {
		start = totalPages - 2
	}
	if start < 1 {
		start = 1
	}
	if end > totalPages {
		end = totalPages
	}
	var out []pageItem
	if start > 1 {
		out = append(out, pageItem{Label: "1", Page: 1})
		if start > 2 {
			out = append(out, pageItem{Ellipsis: true})
		}
	}
	for i := start; i <= end; i++ {
		out = append(out, pageItem{Label: strconv.Itoa(i), Page: i})
	}
	if end < totalPages {
		if end < totalPages-1 {
			out = append(out, pageItem{Ellipsis: true})
		}
		out = append(out, pageItem{Label: strconv.Itoa(totalPages), Page: totalPages})
	}
	return out
}

func pagerDisabled(disabled bool) string {
	if disabled {
		return "pointer-events-none opacity-50"
	}
	return ""
}

func pagerNumberClass(active bool) string {
	if active {
		return "border-indigo-600 bg-indigo-600 text-white dark:border-indigo-500 dark:bg-indigo-500"
	}
	return "border-gray-300 bg-white text-gray-700 hover:bg-gray-50 hover:text-gray-900 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700 dark:hover:text-white"
}
