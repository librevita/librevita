package components

// PagerData carries the state for the flowbite-style pager footer shared
// by the users and patients lists. The htmx attributes refresh the
// table fragment; the hrefs are the no-JS fallback.
type PagerData struct {
	Total    int64
	Shown    int64
	Page     int
	PageSize int

	PrevHref, NextHref     string
	PrevDisabled, NextDisabled bool

	HxGet       string
	HxInclude   string
	HxTarget    string
	HxValsPrev  string
	HxValsNext  string
}

// Pager renders the flowbite pager footer: chevron arrows and the
// visible range on the left, Previous/Next on the right.
templ Pager(p PagerData) {
	if p.Total > 0 {
		<div class="sticky bottom-0 w-full border-t border-gray-200 bg-white p-4 sm:flex sm:items-center sm:justify-between dark:border-gray-800 dark:bg-gray-800">
			<div class="mb-4 flex items-center sm:mb-0">
				<a href={ p.PrevHref } hx-get={ p.HxGet } hx-vals={ p.HxValsPrev } hx-include={ p.HxInclude } hx-target={ p.HxTarget } hx-swap="innerHTML" aria-label="Previous page" class={ "inline-flex justify-center rounded p-1 text-gray-500 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white " + pagerDisabled(p.PrevDisabled) }>
					<svg class="h-7 w-7" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
				</a>
				<a href={ p.NextHref } hx-get={ p.HxGet } hx-vals={ p.HxValsNext } hx-include={ p.HxInclude } hx-target={ p.HxTarget } hx-swap="innerHTML" aria-label="Next page" class={ "mr-2 inline-flex justify-center rounded p-1 text-gray-500 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white " + pagerDisabled(p.NextDisabled) }>
					<svg class="h-7 w-7" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
				</a>
				<span class="text-sm font-normal text-gray-500 dark:text-gray-400">Showing
					<span class="font-semibold text-gray-900 dark:text-white">{ int64(p.Page-1)*int64(p.PageSize) + 1 }-{ int64(p.Page-1)*int64(p.PageSize) + p.Shown }</span> of
					<span class="font-semibold text-gray-900 dark:text-white">{ p.Total }</span>
				</span>
			</div>
			<div class="flex items-center gap-3">
				<a href={ p.PrevHref } hx-get={ p.HxGet } hx-vals={ p.HxValsPrev } hx-include={ p.HxInclude } hx-target={ p.HxTarget } hx-swap="innerHTML" class={ "inline-flex items-center justify-center rounded-lg bg-indigo-600 px-3 py-2 text-sm font-medium text-white hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-600 " + pagerDisabled(p.PrevDisabled) }>
					<svg class="mr-1 h-5 w-5 -ml-1" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
					Previous
				</a>
				<a href={ p.NextHref } hx-get={ p.HxGet } hx-vals={ p.HxValsNext } hx-include={ p.HxInclude } hx-target={ p.HxTarget } hx-swap="innerHTML" class={ "inline-flex items-center justify-center rounded-lg bg-indigo-600 px-3 py-2 text-sm font-medium text-white hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-600 " + pagerDisabled(p.NextDisabled) }>
					Next
					<svg class="ml-1 h-5 w-5 -mr-1" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
				</a>
			</div>
		</div>
	}
}

func pagerDisabled(disabled bool) string {
	if disabled {
		return "pointer-events-none opacity-50"
	}
	return ""
}
