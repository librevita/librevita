{
  "name": "librevita",
  "private": true,
  "type": "module",
  "description": "Frontend build for the LibreVita web application",
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "css": "tailwindcss -i internal/ui/input.css -o /out/app.css --minify -c tailwind.config.ts",
    "bundle": "node internal/ui/build.ts",
    "build": "npm run check && npm run css && npm run bundle",
    "typecheck": "npm run check",
    "test": "node --test internal/ui/test/ui_test.ts"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "htmx.org": "1.9.12",
    "linkedom": "^0.18.10",
    "tailwindcss": "3.4.17",
    "typescript": "^5.7.3"
  }
}
