{
  "name": "librevita",
  "private": true,
  "type": "module",
  "description": "Frontend build for the LibreVita web application",
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "assets": "node internal/ui/build.ts",
    "build": "npm run check && npm run assets",
    "typecheck": "npm run check",
    "test": "node --import ./internal/ui/test-loader.ts --test internal/ui/ts/ui_test.ts"
  },
  "devDependencies": {
    "@alpinejs/csp": "^3.16.1",
    "@alpinejs/focus": "^3.16.1",
    "@alpinejs/morph": "^3.16.1",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@fontsource/inter": "^5.3.0",
    "@types/node": "^26.2.0",
    "alpinejs": "^3.16.1",
    "autoprefixer": "^10.5.4",
    "cssnano": "^8.0.4",
    "esbuild": "0.28.1",
    "linkedom": "^0.18.10",
    "postcss": "^8.5.26",
    "postcss-combine-media-query": "^2.1.0",
    "postcss-sort-media-queries": "^6.7.1",
    "tailwindcss": "3.4.17",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "htmx-types": "1.0.1",
    "htmx.org": "1.9.12"
  },
  "browserslist": [
    "Firefox >= 45"
  ],
  "allowScripts": {
    "esbuild": true
  }
}
